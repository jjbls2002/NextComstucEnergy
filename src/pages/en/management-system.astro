---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { navItems } from "../../data/site";

const lang = "en";
const nav = navItems(lang);

const pillars = [
  {
    icon: "award",
    title: "Quality",
    std: ["ISO 9001", "API Q2"],
    text: "Planning, control and verification of every service to deliver exactly what was agreed with the client, with documentary traceability from start to finish.",
  },
  {
    icon: "leaf",
    title: "Environment",
    std: ["ISO 14001"],
    text: "Identification of environmental aspects, pollution prevention, responsible waste handling and compliance with applicable environmental regulations.",
  },
  {
    icon: "hard-hat",
    title: "Safety & Health",
    std: ["ISO 45001", "LOPCYMAT"],
    text: "IPER matrices, work permits, HSE induction and health surveillance of our people, in line with Venezuelan occupational safety legislation.",
  },
  {
    icon: "scale",
    title: "Compliance",
    std: ["FCPA", "UKBA", "UNGP"],
    text: "Anti-corruption controls, counterparty due diligence and respect for human rights across the entire value chain.",
  },
  {
    icon: "lock",
    title: "Information Security",
    std: ["ISO/IEC 27001"],
    text: "Protection of client and company information: confidentiality, access control and handling of documentation under confidentiality agreements.",
  },
  {
    icon: "refresh-cw",
    title: "Business Continuity",
    std: ["ISO 22301"],
    text: "Plans to sustain operations through contingencies, with impact analysis, defined roles and a coordinated response.",
  },
  {
    icon: "users",
    title: "Talent Management",
    std: ["ISO 9001 cl.7.2", "API Q2"],
    text: "Selection, induction, training and competence assessment of the people assigned to each service.",
  },
];

// Ring positions (7 nodes, starting at the top)
const R = 41;
const orbit = pillars.map((p, i) => {
  const a = (-90 + (360 / pillars.length) * i) * (Math.PI / 180);
  return { ...p, x: +(50 + R * Math.cos(a)).toFixed(2), y: +(50 + R * Math.sin(a)).toFixed(2) };
});

const levels = [
  { title: "Policy", text: "States the Presidency's commitments on quality, environment, safety and integrity." },
  { title: "Manuals", text: "Describe how the system is organized and how the seven pillars fit together." },
  { title: "Procedures", text: "Define who does what, when and with which controls in each process." },
  { title: "Work instructions", text: "Detail, step by step, the critical tasks carried out in the field." },
  { title: "Records", text: "Prove what was done and feed audits and improvement." },
];

const pdca = [
  { k: "P", title: "Plan", text: "Objectives, indicators and risk matrices defined per pillar and per service line." },
  { k: "D", title: "Do", text: "Execution according to procedures and work instructions, with inducted personnel and valid permits." },
  {
    k: "C",
    title: "Check",
    text: "Annual internal audit program with qualified auditors, and readiness for client and certification-body audits.",
  },
  { k: "A", title: "Act", text: "Findings turned into corrective actions with closure verification, and lessons built back into the documents." },
];

const roadmap = ["ISO 9001", "ISO 14001", "ISO 45001"];
---

<BaseLayout
  title="Integrated Management System (IMS) | NEX | 7 ISO Pillars"
  description="NEX's Integrated Management System rests on 7 pillars aligned to ISO 9001, 14001, 45001, 27001, 22301 and API Q2, with internal and external audits."
  keywords="integrated management system, ISO 9001 venezuela, ISO 14001, ISO 45001, API Q2, oil IMS"
  esRest="/sistema-gestion/"
  enRest="/management-system/"
  breadcrumbs={[{ name: "Home", path: "/en/" }, { name: "Management System" }]}
>
  <!-- ============ Hero with orbit diagram ============ -->
  <section class="sig-hero">
    <div class="container-nex flex flex-col items-center text-center">
      <p class="eyebrow mt-6 anim-in" style="animation-delay:.05s">Integrated Management System</p>
      <h1 class="sig-hero__title text-grad-brand anim-in" style="animation-delay:.1s">Seven pillars that support every service</h1>
      <p class="lead sig-hero__lead anim-in" style="animation-delay:.18s">
        A single management system integrating quality, environment, safety, compliance, information, continuity and talent. All seven pillars share processes, indicators and audits.
      </p>

      <div class="orbit anim-in" style="animation-delay:.26s">
        <svg class="orbit__svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="sig-ring" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#2f78b4" />
              <stop offset="100%" stop-color="#3f8a4a" />
            </linearGradient>
          </defs>
          <circle cx="50" cy="50" r="48" class="orbit__halo" />
          <circle cx="50" cy="50" r={R} class="orbit__ring" />
          <circle cx="50" cy="50" r={R} class="orbit__ring-dash" />
          <circle cx="50" cy="50" r="24" class="orbit__inner" />
          {orbit.map((o) => <line x1="50" y1="50" x2={o.x} y2={o.y} class="orbit__spoke" />)}
        </svg>
        <div class="orbit__core" aria-hidden="true">
          <span class="orbit__core-name">NEX</span>
          <span class="orbit__core-sub">IMS</span>
        </div>
        <ul class="orbit__nodes" aria-label="Pillars of the integrated management system">
          {orbit.map((o, i) => (
            <li class="orbit__node" style={`--x:${o.x}%;--y:${o.y}%`}>
              <a href="#pillars" class="orbit__link" data-pillar={i}>
                <span class={`orbit__dot ${i % 2 ? "orbit__dot--green" : ""}`} aria-hidden="true"><Icon name={o.icon} size={20} /></span>
                <span class="orbit__label">{o.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ Document hierarchy ============ -->
  <section class="sig-section">
    <div class="container-nex docs">
      <div class="docs__intro reveal">
        <p class="eyebrow">Document architecture</p>
        <h2 class="title-split mt-5 text-3xl md:text-[44px] leading-[1.05]">From commitment <span>to evidence</span></h2>
        <p class="lead mt-5">Each level rests on the one above it. The policy sets the direction and the records prove it was followed, with documentation available under a confidentiality agreement.</p>
        <span class="section-rule mt-8"></span>
      </div>
      <ol class="pyramid">
        {levels.map((l, i) => (
          <li class="pyramid__row reveal" style={`--d:${i * 0.08}s;--w:${40 + i * 15}%;--c:${(((1 - (25 + i * 15) / (40 + i * 15)) / 2) * 100).toFixed(2)}%`}>
            <div class="pyramid__bar-wrap" aria-hidden="true">
              <span class="pyramid__bar" style={`--lvl:${i}`}>{String(i + 1).padStart(2, "0")}</span>
            </div>
            <div class="pyramid__text">
              <h3 class="pyramid__title">{l.title}</h3>
              <p class="pyramid__desc">{l.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ Pillars: tabs ============ -->
  <section id="pillars" class="sig-section sig-section--alt">
    <div class="container-nex">
      <div class="text-center flex flex-col items-center">
        <p class="eyebrow reveal">The 7 pillars</p>
        <h2 class="title-split text-center mt-5 text-3xl md:text-[44px] leading-[1.05] reveal" style="--d:.05s">An integrated <span>management architecture</span></h2>
      </div>

      <div class="tabs frame reveal" style="--d:.1s" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="System pillars" aria-orientation="vertical">
          {pillars.map((p, i) => (
            <button
              type="button"
              role="tab"
              class="tabs__tab"
              id={`sig-tab-${i}`}
              aria-controls={`sig-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tabs__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="tabs__name">{p.title}</span>
              <Icon name="arrow-right" size={16} class="tabs__arrow" />
            </button>
          ))}
        </div>
        <div class="tabs__panels">
          {pillars.map((p, i) => (
            <div
              class="tabs__panel"
              role="tabpanel"
              id={`sig-panel-${i}`}
              aria-labelledby={`sig-tab-${i}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <div class="tabs__panel-head">
                <span class={`icon-tile ${i % 2 ? "icon-tile--green" : ""}`} aria-hidden="true"><Icon name={p.icon} size={26} /></span>
                <span class="tabs__big" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <h3 class="tabs__title">{p.title}</h3>
              <p class="tabs__text">{p.text}</p>
              <p class="tabs__std-label">Reference standards</p>
              <ul class="tabs__std">
                {p.std.map((s) => <li class="chip">{s}</li>)}
              </ul>
              <p class="tabs__note"><Icon name="layers" size={16} /> Shares processes, indicators and audits with the other six pillars.</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Continuous improvement PDCA ============ -->
  <section class="sig-section">
    <div class="container-nex">
      <div class="pdca-head">
        <div class="reveal">
          <p class="eyebrow">Continuous improvement</p>
          <h2 class="title-split mt-5 text-3xl md:text-[44px] leading-[1.05]">Plan, do, <span>check and act</span></h2>
        </div>
        <p class="lead pdca-head__lead reveal" style="--d:.1s">The PDCA cycle drives the whole system. Internal and external audits close each turn and open the next one.</p>
      </div>

      <div class="pdca reveal">
        {pdca.map((c, i) => (
          <article class={`pdca__card pdca__card--${i + 1}`}>
            <span class={`pdca__key ${i % 2 ? "pdca__key--green" : ""}`} aria-hidden="true">{c.k}</span>
            <h3 class="pdca__title">{c.title}</h3>
            <p class="pdca__text">{c.text}</p>
          </article>
        ))}
        <figure class="pdca__photo">
          <img
            src="/images/gestion.webp"
            width="1800"
            height="1201"
            alt="Two professionals reviewing a printed plan together at a work table"
            loading="lazy"
            decoding="async"
          />
          <span class="pdca__cycle" aria-hidden="true"><Icon name="refresh-cw" size={22} /></span>
        </figure>
      </div>

      <!-- Roadmap -->
      <div class="road frame reveal">
        <div class="road__inner">
          <div class="road__intro">
            <p class="eyebrow">Roadmap</p>
            <h3 class="road__title">Certifications on the way</h3>
          </div>
          <ol class="road__track">
            {roadmap.map((c, i) => (
              <li class="road__step">
                <span class={`road__dot ${i === 2 ? "road__dot--green" : ""}`} aria-hidden="true"></span>
                <span class="road__std">{c}</span>
                <span class="road__meta">Certification target: year 3</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Get to know our system in detail"
    text="Request IMS documentation under a confidentiality agreement."
    ctaLabel="Request proposal"
    ctaHref={nav.contact}
    secondaryLabel="View HSE & Compliance"
    secondaryHref={nav.hse}
  />
</BaseLayout>

<script>
  function initSigTabs() {
    const root = document.querySelector<HTMLElement>("[data-tabs]");
    if (!root) return;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === "ArrowDown" || e.key === "ArrowRight") next = i === last ? 0 : i + 1;
        else if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = i === 0 ? last : i - 1;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = last;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-pillar]").forEach((link) => {
      link.addEventListener("click", () => {
        const i = Number(link.dataset.pillar);
        if (!Number.isNaN(i) && tabs[i]) select(i);
      });
    });
  }
  initSigTabs();
</script>

<style>
  /* ---------- Hero ---------- */
  .sig-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 140px 0 72px;
  }
  .sig-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 46%;
    width: min(980px, 140vw);
    height: min(980px, 140vw);
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(47, 120, 180, 0.16), rgba(104, 176, 90, 0.06) 55%, transparent);
    filter: blur(30px);
    pointer-events: none;
  }
  .sig-crumbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    color: #5c6873;
  }
  .sig-crumbs a {
    transition: color 0.2s ease;
  }
  .sig-crumbs a:hover,
  .sig-crumbs [aria-current] {
    color: var(--nex-ink);
  }
  .sig-hero__title {
    max-width: 860px;
    margin-top: 20px;
    font-size: clamp(36px, 5.2vw, 66px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .sig-hero__lead {
    max-width: 640px;
    margin-top: 20px;
  }

  /* ---------- Orbit ---------- */
  .orbit {
    position: relative;
    width: min(640px, 100%);
    aspect-ratio: 1;
    margin-top: 40px;
  }
  .orbit__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .orbit__halo {
    fill: rgba(255, 255, 255, 0.5);
    stroke: rgba(16, 42, 67, 0.06);
    stroke-width: 0.2;
  }
  .orbit__ring {
    fill: none;
    stroke: url(#sig-ring);
    stroke-width: 0.35;
    opacity: 0.55;
  }
  .orbit__ring-dash {
    fill: none;
    stroke: #2f78b4;
    stroke-width: 0.7;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
    opacity: 0.5;
    transform-origin: 50% 50%;
    animation: orbit-spin 60s linear infinite;
  }
  .orbit__inner {
    fill: none;
    stroke: rgba(47, 120, 180, 0.18);
    stroke-width: 0.25;
    stroke-dasharray: 0.8 1.6;
  }
  .orbit__spoke {
    stroke: rgba(47, 120, 180, 0.22);
    stroke-width: 0.25;
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .orbit__core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    align-content: center;
    width: 26%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #4d9ccc, #2f78b4 45%, #17405f 80%, #2c6e4c);
    box-shadow:
      0 0 0 10px rgba(47, 120, 180, 0.08),
      0 0 0 22px rgba(47, 120, 180, 0.04),
      0 30px 60px -20px rgba(23, 64, 95, 0.6),
      inset 0 2px 0 rgba(255, 255, 255, 0.25);
    animation: core-breathe 6s ease-in-out infinite;
  }
  @keyframes core-breathe {
    50% {
      box-shadow:
        0 0 0 14px rgba(47, 120, 180, 0.1),
        0 0 0 30px rgba(47, 120, 180, 0.04),
        0 30px 60px -20px rgba(23, 64, 95, 0.6),
        inset 0 2px 0 rgba(255, 255, 255, 0.25);
    }
  }
  .orbit__core-name {
    font-size: clamp(22px, 3.4vw, 34px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
  }
  .orbit__core-sub {
    margin-top: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.75);
  }
  .orbit__nodes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .orbit__node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -22px);
  }
  .orbit__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 132px;
    border-radius: 14px;
    outline-offset: 4px;
  }
  .orbit__dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--nex-azul);
    background: #fff;
    border: 1px solid rgba(47, 120, 180, 0.25);
    box-shadow:
      0 0 0 6px rgba(246, 249, 251, 0.9),
      0 10px 24px -10px rgba(47, 120, 180, 0.45);
    transition:
      transform 0.45s var(--nex-ease),
      background 0.3s ease,
      color 0.3s ease,
      box-shadow 0.4s ease;
  }
  .orbit__dot--green {
    color: var(--nex-verde-deep);
    border-color: rgba(63, 138, 74, 0.3);
  }
  .orbit__label {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
    color: #33414c;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(16, 42, 67, 0.08);
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.45s var(--nex-ease);
  }
  .orbit__link:hover .orbit__dot,
  .orbit__link:focus-visible .orbit__dot {
    transform: translateY(-3px) scale(1.12);
    color: #fff;
    background: linear-gradient(160deg, #4d9ccc, var(--nex-azul) 70%);
    border-color: transparent;
    box-shadow:
      0 0 0 6px rgba(47, 120, 180, 0.14),
      0 18px 50px -12px rgba(47, 120, 180, 0.6);
  }
  .orbit__link:hover .orbit__dot--green,
  .orbit__link:focus-visible .orbit__dot--green {
    background: linear-gradient(160deg, #5aa84c, var(--nex-verde-deep) 80%);
  }
  .orbit__link:hover .orbit__label,
  .orbit__link:focus-visible .orbit__label {
    color: var(--nex-ink);
    border-color: rgba(47, 120, 180, 0.3);
    transform: translateY(-2px);
  }

  /* ---------- Sections ---------- */
  .sig-section {
    position: relative;
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .sig-section--alt {
    background: linear-gradient(180deg, #eef4f8, #f6f9fb);
  }

  /* ---------- Pyramid ---------- */
  .docs {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .pyramid {
    display: grid;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pyramid__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }
  .pyramid__bar-wrap {
    display: flex;
    justify-content: center;
    align-self: stretch;
  }
  .pyramid__bar {
    display: grid;
    place-items: center;
    width: var(--w);
    min-height: 58px;
    clip-path: polygon(var(--c) 0, calc(100% - var(--c)) 0, 100% 100%, 0 100%);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    background: linear-gradient(100deg, #17405f, #2f78b4);
    background: linear-gradient(
      100deg,
      color-mix(in srgb, #17405f calc(100% - var(--lvl) * 18%), #3f8a4a),
      color-mix(in srgb, #2f78b4 calc(100% - var(--lvl) * 20%), #68b05a)
    );
    transition: transform 0.5s var(--nex-ease), filter 0.3s ease;
  }
  .pyramid__row:hover .pyramid__bar {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }
  .pyramid__text {
    padding: 10px 0 10px 18px;
    border-left: 1px solid rgba(47, 120, 180, 0.2);
    transition: border-color 0.3s ease;
  }
  .pyramid__row:hover .pyramid__text {
    border-color: var(--nex-azul);
  }
  .pyramid__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--nex-ink);
  }
  .pyramid__desc {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--nex-gris);
  }

  /* ---------- Tabs ---------- */
  .tabs {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 8px;
    margin-top: 48px;
    background: rgba(255, 255, 255, 0.55);
  }
  .tabs__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid rgba(16, 42, 67, 0.081);
  }
  .tabs__tab {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #33414c;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .tabs__tab:hover {
    background: var(--nex-fondo);
    color: var(--nex-ink);
  }
  .tabs__tab:focus-visible {
    outline: 2px solid var(--nex-azul);
    outline-offset: 2px;
  }
  .tabs__tab[aria-selected="true"] {
    color: var(--nex-ink);
    background: linear-gradient(100deg, rgba(47, 120, 180, 0.1), rgba(104, 176, 90, 0.06));
    border-color: rgba(47, 120, 180, 0.22);
  }
  .tabs__num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--nex-gris);
    font-variant-numeric: tabular-nums;
  }
  .tabs__tab[aria-selected="true"] .tabs__num {
    color: var(--nex-azul);
  }
  .tabs__name {
    flex: 1;
    min-width: 0;
  }
