---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { CORP, navItems } from "../../data/site";

const nav = navItems("en");
const tel = `tel:${CORP.phone.replace(/[\s-]/g, "")}`;
const whatsapp = "https://wa.me/584244375975";

const channels = [
  { icon: "phone", label: "Phone", value: CORP.phone, href: tel, note: "Monday to Friday, office hours" },
  { icon: "chat", label: "WhatsApp", value: "Message us on chat", href: whatsapp, external: true, note: CORP.phone },
  { icon: "mail", label: "Email", value: CORP.email, href: `mailto:${CORP.email}`, note: "Proposals, tenders and inquiries" },
];

const nextSteps = [
  { icon: "clipboard-check", title: "We review your request", text: "A technical lead reads your message and replies within 48 business hours at most." },
  { icon: "phone", title: "Technical call or site visit", text: "We clarify the scope by phone and, when the work requires it, arrange a visit to the site." },
  { icon: "file-text", title: "Technical and commercial proposal", text: "You receive an offer with scope, schedule, resources and the contract model that fits best." },
];

const faqs = [
  {
    q: "How quickly do you respond?",
    a: "We answer every request within 48 business hours at most. For operational emergencies, call us or message us on WhatsApp for a faster response.",
  },
  {
    q: "Which areas of Venezuela do you cover?",
    a: `Our base is in ${CORP.city}, ${CORP.region} State. From there we serve projects across the central and eastern plains, and we mobilize crews and equipment to other regions of the country depending on the scope of work.`,
  },
  {
    q: "Which services can I request?",
    a: "Seven lines: civil works and infrastructure, mechanical maintenance and welding, pipeline installation and maintenance, environmental management and remediation, chemical products, transport and logistics, and specialized staffing. You can combine several in a single project.",
  },
  {
    q: "How do I send a tender package?",
    a: `Send the tender documents and attachments to ${CORP.email}, stating the process number and the bid deadline. You can also use the form on this page to describe the scope; we will confirm receipt.`,
  },
];
---

<BaseLayout
  title="Contact | NEX Comstuct & Energy | Request a Proposal"
  description="Contact NEX Comstuct & Energy in Valle de la Pascua, Guárico: +58 424-437-5975 and administracion@nexcomstuct.com. Reply within 48 business hours."
  keywords="contact NEX, request a proposal, industrial contractor guarico, send tender, valle de la pascua"
  esRest="/contacto/"
  enRest="/contact/"
  breadcrumbs={[{ name: "Home", path: "/en/" }, { name: "Contact" }]}
>
  <!-- Split concierge -->
  <section class="cx">
    <div class="container-nex cx__grid">
      <aside class="cx-panel band-dark anim-in" aria-labelledby="cx-title">

        <p class="cx-kicker">Direct contact</p>
        <h1 id="cx-title" class="cx-title">Let's talk about your next project</h1>
        <p class="cx-text">
          Tell us what your operation needs. A technical lead will reply with a solution tailored to your scope, timeline and work site.
        </p>

        <ul class="cx-channels">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                class="cx-channel"
                {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <span class="cx-channel__icon">
                  {c.icon === "chat" ? (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.5L3 21l2-5.6A8.4 8.4 0 1 1 21 11.5Z" /><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01" /></svg>
                  ) : (
                    <Icon name={c.icon} size={20} />
                  )}
                </span>
                <span class="cx-channel__body">
                  <span class="cx-channel__label">{c.label}</span>
                  <span class="cx-channel__value">{c.value}</span>
                  <span class="cx-channel__note">{c.note}</span>
                </span>
                <span class="cx-channel__go" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
              </a>
            </li>
          ))}
          <li>
            <div class="cx-channel cx-channel--static">
              <span class="cx-channel__icon"><Icon name="map-pin" size={20} /></span>
              <span class="cx-channel__body">
                <span class="cx-channel__label">Address</span>
                <span class="cx-channel__value cx-channel__value--sm">{CORP.addressLine}</span>
                <span class="cx-channel__note">{CORP.city}, {CORP.region} State, Venezuela</span>
              </span>
            </div>
          </li>
        </ul>

        <p class="cx-legal">{CORP.legalName} | Tax ID (RIF) {CORP.rif}</p>
      </aside>

      <div class="cx-form anim-in" style="animation-delay:.12s">
        <div class="cx-form__head">
          <span class="icon-tile"><Icon name="mail" size={22} /></span>
          <div>
            <h2 class="cx-form__title">Request a proposal</h2>
            <p class="cx-form__sub">Fields marked * are required. Your data is only used to answer your inquiry.</p>
          </div>
        </div>
        <ContactForm formName="contact" action="/en/thanks/" />
      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="cx-next" aria-labelledby="cx-next-title">
    <div class="container-nex cx-next__grid">
      <figure class="cx-next__photo reveal">
        <img src="/images/contacto.webp" alt="Industrial valves at a process facility" width="1100" height="1650" loading="lazy" decoding="async" />
        <figcaption class="cx-next__badge">
          <Icon name="check-circle" size={18} />
          Reply within 48 business hours
        </figcaption>
      </figure>

      <div>
        <p class="eyebrow reveal">After you write</p>
        <h2 id="cx-next-title" class="title-split cx-h2 reveal" style="--d:.05s">
          What happens next
          <span>after you send your message</span>
        </h2>
        <ol class="cx-steps">
          {nextSteps.map((s, i) => (
            <li class="cx-step reveal" style={`--d:${(0.1 + i * 0.08).toFixed(2)}s`}>
              <span class="cx-step__num">0{i + 1}</span>
              <div class="cx-step__body">
                <h3 class="cx-step__title"><Icon name={s.icon} size={18} /> {s.title}</h3>
                <p class="cx-step__text">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="cx-map" aria-labelledby="cx-map-title">
    <div class="container-nex">
      <div class="cx-map__head">
        <p class="eyebrow reveal">Location</p>
        <h2 id="cx-map-title" class="title-split cx-h2 reveal" style="--d:.05s">
          Valle de la Pascua
          <span>Guárico State, Venezuela</span>
        </h2>
      </div>
      <div class="cx-map__wrap reveal">
        <div class="cx-map__frame">
          <iframe
            title="Map of Valle de la Pascua, Guárico"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-66.08%2C9.15%2C-65.92%2C9.26&layer=mapnik&marker=9.2116%2C-66.0055"
          ></iframe>
        </div>
        <div class="cx-map__card">
          <span class="icon-tile icon-tile--green"><Icon name="building" size={22} /></span>
          <p class="cx-map__name">{CORP.displayName}</p>
          <address class="cx-map__addr">
            {CORP.addressLine}<br />
            {CORP.city}, {CORP.region} State<br />
            Venezuela
          </address>
          <a href={tel} class="btn btn-secondary btn-sm">
            <Icon name="phone" size={16} /> {CORP.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cx-faq" aria-labelledby="cx-faq-title">
    <div class="container-nex cx-faq__grid">
      <div>
        <p class="eyebrow reveal">Frequently asked questions</p>
        <h2 id="cx-faq-title" class="title-split cx-h2 reveal" style="--d:.05s">
          Before you write
          <span>what clients usually ask</span>
        </h2>
        <p class="lead cx-faq__lead reveal" style="--d:.1s">
          If your question is not here, send it through the form or by email and we will answer it.
        </p>
      </div>
      <div class="cx-faq__list">
        {faqs.map((f, i) => (
          <details class="faq__item reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <summary class="faq__q">{f.q}<span class="faq__icon"></span></summary>
            <div class="faq__a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Split concierge ---------- */
  .cx {
    padding: 140px 0 100px;
  }
  .cx__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
    gap: 1.5rem;
    align-items: stretch;
  }
  .cx-panel {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: 32px;
    padding: 2.5rem 2.25rem;
    color: rgba(255, 255, 255, 0.8);
    box-shadow: 0 30px 80px -30px rgba(15, 53, 84, 0.55);
  }
  .cx-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .cx-crumbs a {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.25s ease;
  }
  .cx-crumbs a:hover {
    color: #fff;
  }
  .cx-crumbs [aria-current] {
    color: #fff;
  }
  .cx-kicker {
    margin-top: 0;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a9d6ee;
  }
  .cx-title {
    margin-top: 0.9rem;
    font-size: clamp(2.1rem, 3.8vw, 3.2rem);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: #fff;
    max-width: 14ch;
  }
  .cx-text {
    margin-top: 1.1rem;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }
  .cx-channels {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .cx-channel {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.1rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      transform 0.45s var(--nex-ease),
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.45s var(--nex-ease);
  }
  a.cx-channel:hover,
  a.cx-channel:focus-visible {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.36);
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.45);
  }
  .cx-channel--static {
    grid-template-columns: 44px minmax(0, 1fr);
  }
  .cx-channel__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .cx-channel__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cx-channel__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
  }
  .cx-channel__value {
    margin-top: 0.15rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .cx-channel__value--sm {
    font-size: 0.975rem;
    line-height: 1.4;
  }
  .cx-channel__note {
    margin-top: 0.1rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.65);
  }
  .cx-channel__go {
    color: rgba(255, 255, 255, 0.7);
    transition: transform 0.45s var(--nex-ease), color 0.3s ease;
  }
  a.cx-channel:hover .cx-channel__go {
    color: #fff;
    transform: translate(2px, -2px);
  }
  .cx-legal {
    margin-top: auto;
    padding-top: 2rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .cx-form {
    border-radius: 32px;
    padding: 2.5rem 2.25rem;
    background: #fff;
    border: 1px solid rgba(16, 42, 67, 0.081);
    box-shadow: 0 30px 80px -40px rgba(16, 42, 67, 0.3);
  }
  .cx-form__head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid rgba(16, 42, 67, 0.08);
  }
  .cx-form__title {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--nex-ink);
  }
  .cx-form__sub {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--nex-gris);
  }

  /* ---------- Shared heading ---------- */
  .cx-h2 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    line-height: 1.06;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  /* ---------- What happens next ---------- */
  .cx-next {
    padding: 40px 0 110px;
  }
  .cx-next__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 4.5rem;
    align-items: center;
  }
  .cx-next__photo {
    position: relative;
    margin: 0;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 30px 70px -30px rgba(16, 42, 67, 0.45);
  }
  .cx-next__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cx-next__badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--nex-ink);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -10px rgba(16, 42, 67, 0.35);
  }
  .cx-next__badge :global(svg) {
    color: #3f8a4a;
  }
  .cx-steps {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.25rem;
  }
  .cx-step {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(16, 42, 67, 0.1);
  }
  .cx-step:last-child {
    border-bottom: 1px solid rgba(16, 42, 67, 0.1);
  }
  .cx-step__num {
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--nex-azul), #3f8a4a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cx-step__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--nex-ink);
  }
  .cx-step__title :global(svg) {
    color: var(--nex-azul);
    flex: none;
  }
  .cx-step__text {
    margin-top: 0.4rem;
    color: var(--nex-gris);
    line-height: 1.6;
  }

  /* ---------- Map ---------- */
  .cx-map {
    padding: 100px 0 140px;
    background: linear-gradient(180deg, #eef4f8 0%, #f6f9fb 100%);
    border-top: 1px solid rgba(16, 42, 67, 0.08);
  }
  .cx-map__head {
    margin-bottom: 2.5rem;
  }
  .cx-map__wrap {
    position: relative;
  }
  .cx-map__frame {
    padding: 8px;
    border-radius: 32px;
    background: rgba(16, 42, 67, 0.017);
    border: 1px solid rgba(16, 42, 67, 0.081);
  }
  .cx-map__frame iframe {
    display: block;
    width: 100%;
    height: 460px;
    border: 0;
    border-radius: 25px;
  }
  .cx-map__card {
    position: absolute;
    left: 2.5rem;
    bottom: -2.5rem;
    width: min(360px, calc(100% - 5rem));
    padding: 1.75rem;
    border-radius: 24px;
    background: #fff;
    border: 1px solid rgba(16, 42, 67, 0.081);
    box-shadow: 0 18px 50px -12px rgba(47, 120, 180, 0.35);
  }
  .cx-map__name {
    margin-top: 1.1rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--nex-ink);
  }
  .cx-map__addr {
    margin: 0.5rem 0 1.25rem;
    font-style: normal;
    line-height: 1.6;
    color: var(--nex-gris);
  }

  /* ---------- FAQ ---------- */
  .cx-faq {
    padding: 120px 0 130px;
  }
  .cx-faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 4rem;
    align-items: start;
  }
  .cx-faq__lead {
    margin-top: 1.25rem;
    max-width: 38ch;
  }
  .cx-faq__list {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .cx {
      padding: 112px 0 72px;
    }
    .cx__grid,
    .cx-next__grid,
    .cx-faq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cx-next__grid {
      gap: 2.5rem;
    }
    .cx-next__photo {
      aspect-ratio: 4 / 3;
    }
    .cx-faq__grid {
      gap: 2rem;
    }
    .cx-map {
      padding: 72px 0 80px;
    }
    .cx-map__frame iframe {
      height: 340px;
    }
    .cx-map__card {
      position: relative;
      left: auto;
      bottom: auto;
      width: auto;
      margin: -3rem 1rem 0;
    }
    .cx-faq {
      padding: 80px 0 90px;
    }
  }
  @media (max-width: 560px) {
    .cx-panel,
    .cx-form {
      padding: 1.75rem 1.25rem;
      border-radius: 26px;
    }
    .cx-channel {
      grid-template-columns: 40px minmax(0, 1fr) auto;
      gap: 0.75rem;
      padding: 0.9rem;
    }
    .cx-channel--static {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .cx-channel__icon {
      width: 40px;
      height: 40px;
    }
    .cx-step {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
