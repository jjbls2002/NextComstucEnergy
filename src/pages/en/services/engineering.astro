---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ServiceDetail from "../../../components/ServiceDetail.astro";
import { SERVICE_CONTENT } from "../../../data/services";
const lang = "en";
const key = "engineering";
const c = SERVICE_CONTENT[key][lang];
---
<BaseLayout
  title={c.seo.title}
  description={c.seo.description}
  keywords={c.seo.keywords}
  esRest="/servicios/ingenieria/"
  enRest="/services/engineering/"
  breadcrumbs={[{ name: "Home", path: "/en/" }, { name: "Services", path: "/en/services/" }, { name: "Engineering" }]}
  service={{ serviceType: c.serviceType, description: c.seo.description }}
>
  <ServiceDetail serviceKey={key} lang={lang} />
</BaseLayout>
