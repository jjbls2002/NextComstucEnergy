---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { CORP, SERVICES, navItems } from "../../data/site";

const lang = "en";
const nav = navItems(lang);

const heroFacts = [
  { k: "Founded", v: CORP.founded, icon: "building" },
  { k: "Operating base", v: `${CORP.city}, ${CORP.region}`, icon: "map-pin" },
  { k: "Service lines", v: `${SERVICES.length} lines`, icon: "layers" },
];

const ficha = [
  { k: "Legal name", v: CORP.legalName },
  { k: "Legal form", v: "Compañía Anónima (C.A.)" },
  { k: "Tax ID (RIF)", v: CORP.rif },
  { k: "Registered office", v: `${CORP.addressLine}, ${CORP.city}, ${CORP.region} State, Venezuela` },
  { k: "President", v: CORP.president },
  { k: "Year incorporated", v: CORP.founded },
];

const values = [
  { icon: "shield-check", title: "Safety first", text: "No operational target justifies a safety deviation." },
  { icon: "scale", title: "Integrity", text: "Built-in anti-corruption compliance: FCPA, UKBA and OFAC." },
  { icon: "bar-chart", title: "Financial discipline", text: "Cost control, traceability and accountability." },
  { icon: "leaf", title: "Environmental commitment", text: "Prevention, remediation and compliance with environmental law." },
  { icon: "award", title: "Technical excellence", text: "Certified personnel and international standards on every line." },
  { icon: "users", title: "Respect", text: "Human rights, communities and team, per the UN Guiding Principles." },
];

const governance = [
  { level: "01", title: "Shareholders' Assembly", text: "Highest decision-making and corporate control body." },
  { level: "02", title: "Presidency", text: "Strategic direction and institutional representation." },
  { level: "03", title: "Functional management", text: "Operations, HSE, Administration and Commercial." },
  { level: "04", title: "Supervision & field", text: "Technical execution with line and on-site HSE leads." },
];

const zones = [
  { name: "Orinoco Oil Belt", note: "The largest crude reserve in the world." },
  { name: "Eastern Basin of Venezuela", note: "Consolidated conventional production." },
  { name: "Barinas-Apure Basin", note: "Operations in the west of the country." },
];
---

<BaseLayout
  title="About NEX | Venezuelan Industrial Services Company"
  description="NEX is a Venezuelan company based in Valle de la Pascua, Guárico State, with a 2031 vision of USD 7M revenue and IOC qualification."
  keywords="oil gas services company venezuela, NEX Comstuct Energy, oilfield contractor guarico, about us"
  esRest="/nosotros/"
  enRest="/about/"
  breadcrumbs={[{ name: "Home", path: "/en/" }, { name: "About" }]}
>
  <!-- Asymmetric editorial hero -->
  <section class="ab-hero">
    <div class="container-nex ab-hero__grid">
      <div class="ab-hero__copy">
        <p class="eyebrow mt-7 anim-in" style="animation-delay:.05s">About</p>
        <h1 class="ab-hero__title text-grad-brand anim-in" style="animation-delay:.1s">
          A company built as an institution
        </h1>
        <p class="lead ab-hero__lead anim-in" style="animation-delay:.2s">
          NEX Comstuct & Energy is a Venezuelan industrial and oil & gas services company: documented, auditable and aligned with international standards from day one.
        </p>
        <div class="ab-hero__actions anim-in" style="animation-delay:.3s">
          <a href={nav.services} class="btn btn-primary">View services <Icon name="arrow-right" size={18} /></a>
          <a href="#ficha" class="btn btn-secondary">Company profile</a>
        </div>
      </div>

      <div class="ab-hero__media anim-in" style="animation-delay:.15s">
        <div class="ab-hero__photo">
          <img
            src="/images/refineria.webp"
            width="1800"
            height="1200"
            alt="Refinery industrial facilities, the operating environment NEX works in"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <aside class="ab-glass" aria-label="Key facts">
          <ul>
            {heroFacts.map((f) => (
              <li>
                <span class="ab-glass__icon"><Icon name={f.icon} size={18} /></span>
                <span class="ab-glass__txt">
                  <span class="ab-glass__k">{f.k}</span>
                  <span class="ab-glass__v">{f.v}</span>
                </span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="ab-section">
    <div class="container-nex">
      <div class="ab-story">
        <div class="ab-story__head reveal">
          <p class="eyebrow">Track record</p>
          <p class="ab-story__quote">
            We prioritized what most contractors leave for last: order, traceability and compliance.
          </p>
          <p class="ab-story__sign">{CORP.slogan[lang]}</p>
        </div>
        <div class="ab-story__body reveal" style="--d:0.1s">
          <p>NEX Comstuct & Energy C.A. was founded in Valle de la Pascua, Guárico State, at the operational heart of Venezuela's hydrocarbon industry. From incorporation, the company prioritized a complete documentary system, risk matrices per service line and an international compliance framework.</p>
          <p>That order of priorities is deliberate. NEX is designed to work with PDVSA, with the international operators present in the country and with the emerging regional market: clients that demand traceability, HSE discipline and transparency before awarding a single contract.</p>
          <p>Our purpose is to deliver services at international standard in Venezuela and the region, with a management system that lets PDVSA, international operators and development banks trust NEX as a serious, verifiable supplier.</p>
          <ul class="ab-lines" aria-label="Service lines">
            {SERVICES.map((s) => (
              <li class="chip">{s.title[lang]}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission / Vision -->
  <section class="ab-section ab-section--tight">
    <div class="container-nex">
      <div class="ab-head reveal">
        <p class="eyebrow">Direction</p>
        <h2 class="title-split ab-h2">Mission and <span>2031 Vision</span></h2>
      </div>
      <div class="ab-mv">
        <div class="ab-mv__cell reveal">
          <article class="ab-mv__panel ab-mv__panel--light">
            <span class="icon-tile"><Icon name="target" size={22} /></span>
            <p class="ab-mv__label">Mission</p>
            <h3 class="ab-mv__title">Safe, responsible, technically excellent service</h3>
            <p class="ab-mv__text">To deliver safe, environmentally responsible and technically excellent oil & gas services, backed by an auditable management system and an unwavering commitment to integrity.</p>
          </article>
        </div>
        <div class="ab-mv__cell reveal" style="--d:0.1s">
          <article class="ab-mv__panel ab-mv__panel--dark band-dark">
            <span class="ab-mv__icon-dark"><Icon name="trending-up" size={22} /></span>
            <p class="ab-mv__label ab-mv__label--dark">2031 Vision</p>
            <h3 class="ab-mv__title" style="color:#fff">Qualified by international operators</h3>
            <p class="ab-mv__text ab-mv__text--dark">To be an oil & gas services company qualified by international operators, with USD 7M in annual revenue, ISO 9001/14001/45001 certifications and a consolidated presence in Venezuela and the regional market.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="ab-section">
    <div class="container-nex ab-values">
      <div class="ab-values__head reveal">
        <p class="eyebrow">Values</p>
        <h2 class="title-split ab-h2">Six principles <span>that govern every decision</span></h2>
        <p class="ab-muted">Each principle translates into procedures, accountable owners and verifiable evidence in the field.</p>
      </div>
      <ol class="ab-vlist reveal" style="--d:0.1s">
        {values.map((v, i) => (
          <li class="ab-vrow" tabindex="0">
            <span class="ab-vrow__num">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="ab-vrow__title">{v.title}</h3>
            <p class="ab-vrow__text">{v.text}</p>
            <span class="ab-vrow__icon" aria-hidden="true"><Icon name={v.icon} size={20} /></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Governance and location -->
  <section class="ab-section ab-section--tight">
    <div class="container-nex ab-gov">
      <div class="reveal">
        <p class="eyebrow">Corporate governance</p>
        <h2 class="title-split ab-h2 ab-h2--sm">A four-level <span>structure</span></h2>
        <ol class="ab-gov__list">
          {governance.map((g) => (
            <li>
              <span class="ab-gov__lvl">{g.level}</span>
              <div>
                <h3>{g.title}</h3>
                <p>{g.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="ab-loc frame reveal" style="--d:0.1s">
        <div class="card ab-loc__card">
          <p class="eyebrow">Strategic location</p>
          <h3 class="ab-loc__title">Valle de la Pascua, a natural operating hub</h3>
          <p class="ab-muted">Our base is equidistant from the country's three major producing zones, enabling short response times and efficient logistics.</p>
          <ul class="ab-loc__zones">
            {zones.map((z) => (
              <li>
                <span class="ab-loc__pin"><Icon name="map-pin" size={18} /></span>
                <div>
                  <p class="ab-loc__name">{z.name}</p>
                  <p class="ab-loc__note">{z.note}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Company fact sheet -->
  <section class="ab-section" id="ficha">
    <div class="container-nex ab-spec">
      <div class="ab-spec__media reveal">
        <img
          src="/images/obras-civiles-2.webp"
          alt="Crew carrying out civil works at an industrial site" width="1800" height="1352"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="ab-spec__body reveal" style="--d:0.1s">
        <p class="eyebrow">Corporate identity</p>
        <h2 class="title-split ab-h2">Company <span>profile</span></h2>
        <dl class="ab-spec__dl">
          {ficha.map((r) => (
            <div class="ab-spec__row">
              <dt>{r.k}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <CtaBand
    title="Ready to evaluate NEX?"
    text="Request our corporate profile and technical credentials."
    ctaLabel="Request proposal"
    ctaHref={nav.contact}
    secondaryLabel="View services"
    secondaryHref={nav.services}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .ab-hero {
    position: relative;
    isolation: isolate;
    padding: 140px 0 88px;
    overflow: hidden;
  }
  .ab-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -160px;
    right: -10%;
    width: min(900px, 120vw);
    height: 620px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(47, 120, 180, 0.22), rgba(104, 176, 90, 0.08) 60%, transparent);
    filter: blur(50px);
    pointer-events: none;
  }
  .ab-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: center;
  }
  .ab-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: #5c6873;
  }
  .ab-crumbs a {
    transition: color 0.2s ease;
  }
  .ab-crumbs a:hover {
    color: var(--nex-ink);
  }
  .ab-crumbs__current {
    color: var(--nex-ink);
  }
  .ab-hero__title {
    margin-top: 22px;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.045em;
    padding-bottom: 0.06em;
  }
  .ab-hero__lead {
    margin-top: 24px;
    max-width: 520px;
  }
  .ab-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .ab-hero__media {
    position: relative;
    padding-bottom: 40px;
  }
  .ab-hero__photo {
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: 0 30px 80px -30px rgba(16, 42, 67, 0.45);
  }
  .ab-hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s var(--nex-ease);
  }
  .ab-hero__media:hover .ab-hero__photo img {
    transform: scale(1.06);
  }
  .ab-glass {
    position: absolute;
    left: -48px;
    bottom: 0;
    width: min(300px, 80%);
    padding: 18px 20px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 24px 60px -20px rgba(16, 42, 67, 0.35);
  }
  .ab-glass ul {
    display: grid;
    gap: 14px;
  }
  .ab-glass li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ab-glass li + li {
    padding-top: 14px;
    border-top: 1px solid rgba(16, 42, 67, 0.08);
  }
  .ab-glass__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 10px;
    color: var(--nex-azul);
    background: rgba(47, 120, 180, 0.1);
  }
  .ab-glass__txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .ab-glass__k {
    font-size: 12px;
    color: var(--nex-gris);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ab-glass__v {
    font-size: 17px;
    font-weight: 600;
    color: var(--nex-ink);
    letter-spacing: -0.02em;
  }

  /* ---------- Sections ---------- */
  .ab-section {
    padding: 104px 0;
  }
  .ab-section--tight {
    padding: 72px 0;
  }
  .ab-head {
    max-width: 640px;
    margin-bottom: 40px;
  }
  .ab-h2 {
    margin-top: 18px;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .ab-h2--sm {
    font-size: clamp(28px, 3.2vw, 40px);
  }
  .ab-muted {
    margin-top: 16px;
    color: var(--nex-gris);
    line-height: 1.6;
  }

  /* ---------- Story ---------- */
  .ab-story {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 72px;
    padding-top: 48px;
    border-top: 1px solid rgba(16, 42, 67, 0.1);
  }
  .ab-story__quote {
    margin-top: 24px;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--nex-ink);
    text-wrap: balance;
  }
  .ab-story__quote::before {
    content: "\201C";
    display: block;
    font-size: 1.8em;
    line-height: 0.6;
    margin-bottom: 8px;
    background: linear-gradient(90deg, #2f78b4, #3f9a5a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ab-story__sign {
    margin-top: 24px;
    padding-left: 16px;
    border-left: 2px solid var(--nex-verde);
    font-weight: 600;
    color: var(--nex-azul);
  }
  .ab-story__body {
    display: grid;
    gap: 18px;
    align-content: start;
    color: #3d4a55;
    font-size: 17px;
    line-height: 1.7;
  }
  .ab-story__body > p:first-child::first-letter {
    float: left;
    font-size: 3.4em;
    line-height: 0.85;
    padding: 6px 10px 0 0;
    font-weight: 700;
    color: var(--nex-azul);
  }
  .ab-lines {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  /* ---------- Mission / Vision ---------- */
  .ab-mv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .ab-mv__cell {
    display: grid;
  }
  .ab-mv__panel {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: clamp(28px, 4vw, 52px);
    min-height: 360px;
    display: flex;
    flex-direction: column;
    transition: transform 0.45s var(--nex-ease), box-shadow 0.45s var(--nex-ease);
  }
  .ab-mv__panel:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 50px -12px rgba(47, 120, 180, 0.35);
  }
  .ab-mv__panel--light {
    background: #fff;
    border: 1px solid rgba(16, 42, 67, 0.08);
  }
  .ab-mv__icon-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .ab-mv__label {
    margin-top: auto;
    padding-top: 40px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nex-azul);
  }
  .ab-mv__label--dark {
    color: #a9d6ee;
  }
  .ab-mv__title {
    margin-top: 10px;
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--nex-ink);
  }
  .ab-mv__text {
    margin-top: 14px;
    line-height: 1.65;
    color: var(--nex-gris);
  }
  .ab-mv__text--dark {
    color: #dce8ef;
  }

  /* ---------- Values ---------- */
  .ab-values {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
    align-items: start;
  }
  .ab-values__head {
    position: sticky;
    top: 120px;
  }
  .ab-vlist {
    border-top: 1px solid rgba(16, 42, 67, 0.1);
  }
  .ab-vrow {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    grid-template-areas:
      "num title icon"
      "num text icon";
    column-gap: 20px;
    padding: 26px 20px 26px 24px;
    border-bottom: 1px solid rgba(16, 42, 67, 0.1);
    outline: none;
    transition: background 0.45s var(--nex-ease), padding 0.45s var(--nex-ease);
  }
  .ab-vrow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 3px;
    background: linear-gradient(180deg, var(--nex-azul), var(--nex-verde));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s var(--nex-ease);
  }
  .ab-vrow__num {
    grid-area: num;
    font-size: 14px;
    font-weight: 600;
    color: var(--nex-gris);
    padding-top: 6px;
    font-variant-numeric: tabular-nums;
    transition: color 0.35s ease;
  }
  .ab-vrow__title {
    grid-area: title;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--nex-ink);
  }
  .ab-vrow__text {
    grid-area: text;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    color: var(--nex-gris);
    line-height: 1.6;
    transition: max-height 0.5s var(--nex-ease), opacity 0.4s ease, margin 0.45s var(--nex-ease);
  }
  .ab-vrow__icon {
    grid-area: icon;
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--nex-azul);
    background: rgba(47, 120, 180, 0.08);
    transition: transform 0.45s var(--nex-ease), background 0.35s ease, color 0.35s ease;
  }
  .ab-vrow:hover,
  .ab-vrow:focus-visible {
    background: #fff;
    padding-left: 32px;
  }
  .ab-vrow:hover::before,
  .ab-vrow:focus-visible::before {
    transform: scaleY(1);
  }
  .ab-vrow:hover .ab-vrow__num,
  .ab-vrow:focus-visible .ab-vrow__num {
    color: var(--nex-azul);
  }
  .ab-vrow:hover .ab-vrow__text,
  .ab-vrow:focus-visible .ab-vrow__text {
    max-height: 120px;
    opacity: 1;
    margin-top: 8px;
  }
  .ab-vrow:hover .ab-vrow__icon,
  .ab-vrow:focus-visible .ab-vrow__icon {
    color: #fff;
    background: linear-gradient(135deg, var(--nex-azul), #3f8a4a);
    transform: rotate(-6deg);
  }
  /* Touch devices: no hover, always show text */
  @media (hover: none) {
    .ab-vrow__text {
      max-height: none;
      opacity: 1;
      margin-top: 8px;
    }
  }

  /* ---------- Governance + location ---------- */
  .ab-gov {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .ab-gov__list {
    margin-top: 32px;
    display: grid;
    gap: 0;
  }
  .ab-gov__list li {
    display: flex;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(16, 42, 67, 0.08);
  }
  .ab-gov__list li:first-child {
    border-top: 1px solid rgba(16, 42, 67, 0.08);
  }
  .ab-gov__lvl {
    flex: none;
    width: 40px;
    font-size: 13px;
    font-weight: 600;
    color: var(--nex-azul);
    padding-top: 3px;
  }
  .ab-gov__list h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--nex-ink);
  }
  .ab-gov__list p {
    margin-top: 4px;
    font-size: 15px;
    color: var(--nex-gris);
  }
  .ab-loc__title {
    margin-top: 16px;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--nex-ink);
  }
  .ab-loc__zones {
    margin-top: 24px;
    display: grid;
    gap: 14px;
  }
  .ab-loc__zones li {
    display: flex;
