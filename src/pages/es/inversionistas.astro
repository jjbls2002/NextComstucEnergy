---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { CORP, SERVICES, servicePath, navItems } from "../../data/site";

const lang = "es";
const nav = navItems(lang);
const mailInvestor = `mailto:${CORP.email}?subject=${encodeURIComponent("Inversionista | Solicitud de información NEX")}`;

const tickers = [
  { value: "USD 7.3M", label: "Ingresos proyectados, año 5" },
  { value: "~33%", label: "Margen EBITDA, año 5" },
  { value: "USD 750K", label: "Capital semilla" },
  { value: "~150%", label: "ROI base, año 3" },
];

const thesis = [
  {
    title: "Un mercado de gran escala",
    text: "El sector petrolero venezolano demanda contratistas confiables para obras, mantenimiento, tuberías, logística y gestión ambiental en campo.",
  },
  {
    title: "Ocho líneas, un solo contratista",
    text: "Un portafolio diversificado que reduce la dependencia de un único servicio y permite atender contratos integrales con un mismo equipo y un mismo estándar.",
  },
  {
    title: "Disciplina institucional",
    text: "NEX opera con la disciplina que la banca de desarrollo y los inversionistas privados exigen: contabilidad formal, controles y rendición de cuentas desde el primer día.",
  },
  {
    title: "Pipeline ya identificado",
    text: "12 oportunidades comerciales por USD 3.72M en valor potencial, dirigidas a PDVSA, empresas mixtas y operadoras internacionales.",
  },
];

const phases = [
  { tag: "Año 1", year: "2026", title: "Arranque", text: "Constitución, capital semilla de USD 750K y puesta en marcha de las líneas de servicio con contabilidad formal desde el inicio." },
  { tag: "Año 3", year: "Retorno", title: "ROI base ~150%", text: "El escenario base del plan proyecta un retorno sobre la inversión cercano al 150% al tercer año." },
  { tag: "Año 5", year: "Escala", title: "USD 7.3M en ingresos", text: "Ingresos proyectados de USD 7.3M con un margen EBITDA cercano al 33%." },
  { tag: "Horizonte", year: "2031", title: "Cierre del plan", text: "Culminación del Plan de Negocios 2026 a 2031, con un portafolio consolidado de ocho líneas de servicio." },
];

const markets = ["PDVSA", "Empresas mixtas", "Operadoras internacionales"];
const basins = ["Faja del Orinoco", "Cuenca Oriental", "Cuenca Barinas-Apure"];

const governance = [
  { icon: "file-text", title: "Modelo financiero auditable", text: "Proyecciones sustentadas en supuestos verificables y contabilidad formal desde el inicio." },
  { icon: "scale", title: "Cumplimiento integrado", text: "FCPA, UKBA y OFAC incorporados, reduciendo el riesgo reputacional y legal para el inversionista." },
  { icon: "layers", title: "Gobernanza clara", text: "Estructura societaria de cuatro niveles con rendición de cuentas y control." },
];

const docs = [
  "Plan de Negocios 2026 a 2031",
  "Modelo financiero y supuestos",
  "Pipeline comercial detallado",
  "Estructura de la ronda y uso de fondos",
];
---

<BaseLayout
  title="Inversionistas | NEX Comstuct & Energy"
  description="Plan de negocios 2026-2031 de NEX Comstuct & Energy: ocho líneas de servicio, gobierno corporativo y cartera de oportunidades en Venezuela."
  keywords="inversión servicios petroleros venezuela, plan de negocios petrolero, oportunidad inversión oil gas, EBITDA petrolero"
  esRest="/inversionistas/"
  enRest="/investors/"
  breadcrumbs={[{ name: "Inicio", path: "/es/" }, { name: "Inversionistas" }]}
  backdrop="taladro"
>
  <!-- ============ HERO: prospectus cover ============ -->
  <section class="inv-hero">
    <div class="container-nex inv-hero__inner">
      <p class="inv-hero__kicker anim-in" style="animation-delay:.05s">Prospecto | Plan de Negocios 2026 a 2031</p>
      <h1 class="inv-hero__title anim-in" style="animation-delay:.12s">
        Participe en el crecimiento de una empresa <em>institucionalmente sólida</em>
      </h1>
      <p class="inv-hero__lead anim-in" style="animation-delay:.2s">
        NEX combina un mercado de gran escala con la disciplina institucional que la banca de desarrollo y los inversionistas privados exigen.
      </p>
      <div class="inv-hero__actions anim-in" style="animation-delay:.28s">
        <a href={mailInvestor} class="btn btn-primary">Solicitar información <Icon name="arrow-right" size={18} /></a>
        <a href="#plan" class="inv-ghost">Ver el plan <Icon name="chevron-down" size={18} /></a>
      </div>
      <ul class="inv-tickers anim-in" style="animation-delay:.36s" aria-label="Cifras clave del plan">
        {tickers.map((t) => (
          <li class="inv-ticker">
            <span class="inv-ticker__value">{t.value}</span>
            <span class="inv-ticker__label">{t.label}</span>
          </li>
        ))}
      </ul>
      <p class="inv-hero__note anim-in" style="animation-delay:.42s">Proyecciones del Plan de Negocios. Supuestos y modelo completo disponibles bajo acuerdo de confidencialidad.</p>
    </div>
  </section>

  <!-- ============ INVESTMENT THESIS ============ -->
  <section class="inv-section">
    <div class="container-nex">
      <div class="inv-head reveal">
        <span class="eyebrow">Tesis de inversión</span>
        <h2 class="title-split">Cuatro razones <span>para invertir en NEX</span></h2>
      </div>
      <div class="inv-thesis">
        {thesis.map((t, i) => (
          <article class="inv-thesis__card reveal" style={`--d:${i * 0.08}s`}>
            <span class="inv-thesis__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="inv-thesis__title">{t.title}</h3>
            <p class="inv-thesis__text">{t.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BUSINESS PLAN TIMELINE ============ -->
  <section class="inv-section inv-section--alt" id="plan">
    <div class="container-nex">
      <div class="inv-head inv-head--row reveal">
        <div>
          <span class="eyebrow">Plan de Negocios 2026 a 2031</span>
          <h2 class="title-split">Una hoja de ruta <span>con hitos medibles</span></h2>
        </div>
        <p class="lead inv-head__aside">Los hitos se toman del escenario base del plan. El detalle año por año se comparte bajo acuerdo de confidencialidad.</p>
      </div>

      <div class="inv-tl reveal">
        <div class="inv-tl__track" aria-hidden="true"><span class="inv-tl__fill"></span></div>
        <ol class="inv-tl__list">
          {phases.map((p, i) => (
            <li class="inv-tl__item" style={`--i:${i}`}>
              <span class="inv-tl__node" aria-hidden="true"></span>
              <span class="inv-tl__tag">{p.tag}</span>
              <span class="inv-tl__year">{p.year}</span>
              <h3 class="inv-tl__title">{p.title}</h3>
              <p class="inv-tl__text">{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ PIPELINE / MARKETS ============ -->
  <section class="inv-section">
    <div class="container-nex inv-pipe">
      <div class="inv-pipe__side reveal">
        <span class="eyebrow">Pipeline comercial</span>
        <h2 class="title-split">Oportunidades <span>ya identificadas</span></h2>
        <div class="inv-pipe__figs">
          <div>
            <span class="inv-pipe__big">12</span>
            <span class="inv-pipe__cap">oportunidades comerciales identificadas</span>
          </div>
          <div>
            <span class="inv-pipe__big">USD 3.72M</span>
            <span class="inv-pipe__cap">en valor potencial de pipeline</span>
          </div>
        </div>
        <p class="inv-pipe__label">Clientes objetivo</p>
        <ul class="inv-pipe__chips">
          {markets.map((m) => <li class="chip"><Icon name="building" size={15} />{m}</li>)}
        </ul>
        <p class="inv-pipe__label">Cuencas</p>
        <ul class="inv-pipe__chips">
          {basins.map((b) => <li class="chip"><Icon name="map-pin" size={15} />{b}</li>)}
        </ul>
      </div>

      <div class="inv-ledger reveal" style="--d:.1s">
        <div class="inv-ledger__head">
          <span>Portafolio</span>
          <span>Ocho líneas de servicio</span>
        </div>
        <ul class="inv-ledger__rows">
          {SERVICES.map((s) => (
            <li>
              <a href={servicePath(lang, s.key)} class="inv-ledger__row">
                <span class="inv-ledger__num">{s.num}</span>
                <span class="inv-ledger__icon"><Icon name={s.icon} size={18} /></span>
                <span class="inv-ledger__body">
                  <span class="inv-ledger__title">{s.title[lang]}</span>
                  <span class="inv-ledger__short">{s.short[lang]}</span>
                </span>
                <span class="inv-ledger__go" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="inv-ledger__foot">El pipeline se dirige a PDVSA, empresas mixtas y operadoras internacionales en la Faja del Orinoco, la Cuenca Oriental y la Cuenca Barinas-Apure, apoyado en este portafolio integral.</p>
      </div>
    </div>
  </section>

  <!-- ============ GOVERNANCE + INVESTOR CONTACT ============ -->
  <section class="inv-section inv-section--alt">
    <div class="container-nex">
      <div class="inv-head reveal">
        <span class="eyebrow">Gobernanza y cumplimiento</span>
        <h2 class="title-split">Por qué NEX reduce <span>el riesgo del inversionista</span></h2>
      </div>

      <div class="inv-gov">
        <div class="inv-gov__list">
          {governance.map((g, i) => (
            <article class="inv-gov__item reveal" style={`--d:${i * 0.08}s`}>
              <span class="icon-tile"><Icon name={g.icon} size={24} /></span>
              <div>
                <h3 class="inv-gov__title">{g.title}</h3>
                <p class="inv-gov__text">{g.text}</p>
              </div>
            </article>
          ))}
        </div>

        <aside class="frame reveal" style="--d:.15s">
          <div class="card inv-dataroom">
            <span class="inv-dataroom__badge"><Icon name="lock" size={15} /> Disponible bajo NDA</span>
            <h3 class="inv-dataroom__title">Sala de datos para inversionistas</h3>
            <p class="inv-dataroom__text">El Plan de Negocios completo, el modelo financiero y el pipeline detallado se comparten previa firma de un acuerdo de confidencialidad.</p>
            <ul class="inv-dataroom__docs">
              {docs.map((d) => (
                <li><span class="inv-dataroom__check"><Icon name="file-text" size={16} /></span>{d}</li>
              ))}
            </ul>
            <div class="inv-dataroom__actions">
              <a href={mailInvestor} class="btn btn-primary"><Icon name="mail" size={18} /> Escribir por correo</a>
              <a href={nav.contact} class="btn btn-secondary">Formulario de contacto</a>
            </div>
            <p class="inv-dataroom__hint">Correo: <a href={mailInvestor}>{CORP.email}</a>. En el formulario, indique "Inversionista" como tipo de consulta.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand
    title="Agendemos una reunión"
    text="Conversemos sobre la tesis de inversión, el plan 2026 a 2031 y el uso de fondos."
    ctaLabel="Agendar reunión"
    ctaHref={nav.contact}
    secondaryLabel="Escribir por correo"
    secondaryHref={mailInvestor}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .inv-hero {
    position: relative;
    isolation: isolate;
    padding: 168px 0 72px;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: flex-end;
    color: #fff;
  }
  .inv-hero__img {
    -webkit-mask: linear-gradient(180deg, #000 70%, transparent 100%);
    mask: linear-gradient(180deg, #000 70%, transparent 100%);
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .inv-hero__veil {
    -webkit-mask: linear-gradient(180deg, #000 70%, transparent 100%);
    mask: linear-gradient(180deg, #000 70%, transparent 100%);
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(10, 30, 48, 0.55) 0%, rgba(10, 30, 48, 0) 30%),
      linear-gradient(112deg, rgba(15, 53, 84, 0.94) 0%, rgba(23, 64, 95, 0.82) 38%, rgba(28, 90, 110, 0.6) 66%, rgba(44, 110, 76, 0.55) 100%);
  }
  .inv-hero__inner {
    position: relative;
    width: 100%;
  }
  .inv-hero__crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.25rem;
  }
  .inv-hero__crumbs a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  .inv-hero__crumbs a:hover {
    color: #fff;
  }
  .inv-hero__kicker {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a9d6ee;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    margin-bottom: 1.5rem;
  }
  .inv-hero__title {
    max-width: 17ch;
    font-size: clamp(2.25rem, 5.4vw, 4.25rem);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.045em;
    color: #fff;
  }
  .inv-hero__title em {
    font-style: normal;
    background: linear-gradient(90deg, #ffffff 0%, #a9d6ee 45%, #9fd68c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .inv-hero__lead {
    max-width: 56ch;
    margin-top: 1.25rem;
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }
  .inv-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }
  .inv-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 2px;
    transition: border-color 0.3s ease;
  }
  .inv-ghost:hover {
    border-color: #fff;
  }
  .inv-tickers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3rem;
    list-style: none;
    padding: 0;
  }
  .inv-ticker {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: transform 0.5s var(--nex-ease), background 0.3s ease;
  }
  .inv-ticker:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.15);
  }
  .inv-ticker__value {
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    color: #fff;
  }
  .inv-ticker__label {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .inv-hero__note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ---------- Sections ---------- */
  .inv-section {
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .inv-section--alt {
    background: transparent;
    border-block: 1px solid rgba(16, 42, 67, 0.06);
  }
  .inv-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 760px;
  }
  .inv-head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .inv-head--row {
    max-width: none;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .inv-head--row > div {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .inv-head__aside {
    max-width: 38ch;
    color: var(--nex-gris);
    font-size: 0.9375rem;
  }
  .inv-head .eyebrow {
    align-self: flex-start;
  }

  /* ---------- Thesis ---------- */
  .inv-thesis {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .inv-thesis__card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.138);
    transition: transform 0.5s var(--nex-ease), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .inv-thesis__card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--nex-azul) 0%, #3f9a5a 100%);
  }
  .inv-thesis__card:hover {
    transform: translateY(-4px);
    border-color: rgba(47, 120, 180, 0.3);
    box-shadow: 0 18px 50px -12px rgba(47, 120, 180, 0.35);
  }
  .inv-thesis__num {
    display: block;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.06em;
    background: linear-gradient(135deg, #d6ebf6 0%, #a9d6ee 50%, #9fd68c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 1.25rem;
  }
  .inv-thesis__title {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--nex-ink);
    margin-bottom: 0.5rem;
  }
  .inv-thesis__text {
    color: var(--nex-gris);
    line-height: 1.65;
  }

  /* ---------- Timeline ---------- */
  .inv-tl {
    position: relative;
  }
  .inv-tl__track {
    position: absolute;
    top: 9px;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .inv-tl__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--nex-azul), #3f9a5a);
    transform-origin: left center;
  }
  :global(.js) .inv-tl__fill {
    transform: scaleX(0);
    transition: transform 1.8s var(--nex-ease) 0.3s;
  }
  :global(.js) .inv-tl.is-in .inv-tl__fill {
    transform: scaleX(1);
  }
  .inv-tl__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .inv-tl__item {
    padding-top: 2.25rem;
    position: relative;
  }
  .inv-tl__node {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid var(--nex-azul);
    box-shadow: 0 0 0 5px rgba(47, 120, 180, 0.12);
  }
  :global(.js) .inv-tl .inv-tl__node {
    transform: scale(0.4);
    opacity: 0;
    transition: transform 0.6s var(--nex-ease), opacity 0.4s ease;
    transition-delay: calc(0.4s + var(--i) * 0.4s);
  }
  :global(.js) .inv-tl.is-in .inv-tl__node {
    transform: none;
    opacity: 1;
  }
  .inv-tl__item:last-child .inv-tl__node {
    background: linear-gradient(135deg, var(--nex-azul), #3f9a5a);
    border-color: #fff;
  }
  .inv-tl__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--nex-azul-text);
  }
  .inv-tl__year {
    display: block;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1.05;
    color: var(--nex-ink);
    margin: 0.25rem 0 0.75rem;
  }
  .inv-tl__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--nex-ink);
    margin-bottom: 0.4rem;
  }
  .inv-tl__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--nex-gris);
  }

  /* ---------- Pipeline ---------- */
  .inv-pipe {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .inv-pipe__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .inv-pipe__side h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .inv-pipe__figs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    padding: 1.5rem 0;
    margin: 0.5rem 0;
    border-block: 1px solid rgba(16, 42, 67, 0.1);
  }
  .inv-pipe__big {
    display: block;
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(90deg, #d6ebf6 0%, #a9d6ee 55%, #9fd68c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .inv-pipe__cap {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
