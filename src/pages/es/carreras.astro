---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { CORP, SERVICES } from "../../data/site";

const lang = "es";
const privacyHref = "/es/privacidad/";
const mailCv = `mailto:${CORP.email}?subject=${encodeURIComponent("Postulación | CV y carta de intención")}`;

const benefits = {
  hse: { value: "40 h", label: "al año", title: "Formación HSE continua", text: "Mínimo 40 horas anuales de formación en seguridad, salud y ambiente para todo el equipo, en campo y en oficina." },
  career: { title: "Plan de carrera", text: "Trayectorias de crecimiento definidas y desarrollo profesional continuo: entras con un rol y creces con la empresa." },
  lottt: { title: "Cumplimiento pleno de la LOTTT", text: "Relación laboral formal, conforme a la ley." },
  insurance: { title: "Seguros y beneficios", text: "Seguros y beneficios conforme a la ley." },
  extra: [
    { icon: "shield-check", title: "Seguridad real", text: "La autoridad de parada es de verdad y la seguridad no se negocia." },
    { icon: "scale", title: "Integridad", text: "Un entorno donde hacer lo correcto es la norma." },
    { icon: "users", title: "Equipo y respeto", text: "Cultura de respeto, derechos laborales y trabajo en equipo." },
    { icon: "award", title: "Excelencia técnica", text: "Estándares exigentes y aprendizaje en cada línea de servicio." },
  ],
};

const roles: Record<string, string[]> = {
  civil: ["Ingenieros civiles", "Maestros de obra", "Operadores de maquinaria", "Albañiles y carpinteros"],
  mechanical: ["Mecánicos de equipos petroleros", "Soldadores", "Técnicos de motores y bombas", "Supervisores de mantenimiento"],
  pipelines: ["Tuberos", "Soldadores de tubería", "Inspectores de obra", "Ayudantes de campo"],
  environmental: ["Ingenieros ambientales", "Técnicos ambientales", "Operadores de saneamiento", "Cuadrillas de reforestación"],
  chemicals: ["Comercio exterior", "Compras y almacén", "Técnicos químicos"],
  logistics: ["Choferes de carga pesada", "Choferes de carga liviana", "Coordinadores de logística", "Personal de mudanzas"],
  staffing: ["Supervisores HSE", "Administración y finanzas", "Talento humano", "Personal operativo"],
};
const areaName: Record<string, string> = {
  civil: "Obras civiles",
  mechanical: "Mecánica y soldadura",
  pipelines: "Tuberías",
  environmental: "Ambiente y saneamiento",
  chemicals: "Productos químicos",
  logistics: "Transporte y logística",
  staffing: "Administración, HSE y operaciones",
};

const steps = [
  { title: "Envía tu CV", text: "Completa el formulario con tu CV y carta de intención, indicando el área en la que te gustaría trabajar." },
  { title: "Revisión de perfil", text: "Nuestro equipo de talento humano revisa tu experiencia frente a las necesidades de cada línea de servicio." },
  { title: "Entrevista y evaluación", text: "Conversamos contigo y, según el cargo, evaluamos tus competencias técnicas y tu compromiso con la seguridad." },
  { title: "Inducción e incorporación", text: "Si avanzamos juntos, comienzas con una inducción HSE antes de tu primer día en campo u oficina." },
];
---

<BaseLayout
  title="Carreras | NEX Comstuct & Energy | Trabaja con Nosotros"
  description="Construye tu carrera en NEX Comstuct & Energy: formación HSE de 40 h/año, plan de carrera, cumplimiento LOTTT y seguros. Perfiles en obras civiles, mecánica, tuberías, ambiente, logística y más."
  keywords="empleo petrolero venezuela, carreras oil gas, trabajo HSE venezuela, empleo guárico, soldadores, choferes carga pesada"
  esRest="/carreras/"
  enRest="/careers/"
  breadcrumbs={[{ name: "Inicio", path: "/es/" }, { name: "Carreras" }]}
>
  <!-- ============ HERO: photo collage ============ -->
  <section class="car-hero">
    <div class="container-nex car-hero__grid">
      <div class="car-hero__copy">
        <nav class="car-crumbs anim-in" aria-label="Ruta de navegación">
          <a href="/es/">Inicio</a><span aria-hidden="true">/</span><span>Carreras</span>
        </nav>
        <span class="eyebrow anim-in" style="animation-delay:.05s">Carreras en NEX</span>
        <h1 class="car-hero__title text-grad-brand anim-in" style="animation-delay:.12s">
          Únete al equipo que construye con seguridad
        </h1>
        <p class="lead car-hero__lead anim-in" style="animation-delay:.2s">
          Buscamos personas de oficio, técnicos, profesionales y personal HSE que compartan nuestra disciplina de seguridad e integridad, en siete líneas de servicio desde Valle de la Pascua.
        </p>
        <div class="car-hero__actions anim-in" style="animation-delay:.28s">
          <a href="#postular" class="btn btn-primary">Postúlate ahora <Icon name="arrow-right" size={18} /></a>
          <a href="#perfiles" class="btn btn-secondary">Ver perfiles</a>
        </div>
        <ul class="car-hero__facts anim-in" style="animation-delay:.36s">
          <li><Icon name="check-circle" size={18} /> 40 h/año de formación HSE</li>
          <li><Icon name="check-circle" size={18} /> Cumplimiento LOTTT</li>
        </ul>
      </div>

      <div class="car-collage anim-in" style="animation-delay:.18s">
        <figure class="car-collage__main">
          <img src="/images/carreras.webp" alt="Dos profesionales con cascos de seguridad revisando planos en obra" width="1800" height="1200" fetchpriority="high" decoding="async" />
        </figure>
        <figure class="car-collage__second">
          <img src="/images/personal.webp" alt="Equipo de trabajadores con chalecos reflectivos y cascos" width="1800" height="1200" loading="lazy" decoding="async" />
        </figure>
        <div class="car-collage__badge" aria-hidden="true">
          <span class="icon-tile icon-tile--green"><Icon name="hard-hat" size={22} /></span>
          <span><strong>Seguridad primero</strong><small>Autoridad de parada real</small></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BENEFITS BENTO ============ -->
  <section class="car-section">
    <div class="container-nex">
      <div class="car-head reveal">
        <span class="eyebrow">Lo que ofrecemos</span>
        <h2 class="title-split">Un lugar para crecer <span>con respaldo y respeto</span></h2>
      </div>

      <div class="car-bento">
        <article class="car-tile car-tile--hero reveal">
          <span class="icon-tile"><Icon name="shield" size={24} /></span>
          <div class="car-tile__metric"><span>{benefits.hse.value}</span><small>{benefits.hse.label}</small></div>
          <h3>{benefits.hse.title}</h3>
          <p>{benefits.hse.text}</p>
        </article>
        <article class="car-tile car-tile--wide reveal" style="--d:.06s">
          <span class="icon-tile icon-tile--green"><Icon name="trending-up" size={24} /></span>
          <div>
            <h3>{benefits.career.title}</h3>
            <p>{benefits.career.text}</p>
          </div>
        </article>
        <article class="car-tile reveal" style="--d:.12s">
          <span class="car-tile__icon"><Icon name="clipboard-check" size={22} /></span>
          <h3>{benefits.lottt.title}</h3>
          <p>{benefits.lottt.text}</p>
        </article>
        <article class="car-tile reveal" style="--d:.18s">
          <span class="car-tile__icon"><Icon name="handshake" size={22} /></span>
          <h3>{benefits.insurance.title}</h3>
          <p>{benefits.insurance.text}</p>
        </article>
        {benefits.extra.map((b, i) => (
          <article class={`car-tile car-tile--soft reveal${i === 0 ? " car-tile--accent" : ""}`} style={`--d:${0.08 * i}s`}>
            <span class="car-tile__icon"><Icon name={b.icon} size={22} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PROFILES ============ -->
  <section class="car-section car-section--alt" id="perfiles">
    <div class="container-nex">
      <div class="car-head car-head--row reveal">
        <div>
          <span class="eyebrow">Perfiles que buscamos</span>
          <h2 class="title-split">Talento para cada <span>línea de servicio</span></h2>
        </div>
        <p class="car-head__aside">Perfiles de referencia según nuestras áreas de trabajo. No son vacantes publicadas: si te identificas con alguno, deja tu CV y te contactaremos cuando surja una posición acorde.</p>
      </div>

      <div class="car-profiles">
        {SERVICES.map((s, i) => (
          <article class="car-profile reveal" style={`--d:${(i % 3) * 0.07}s`}>
            <header class="car-profile__head">
              <span class={`icon-tile${i % 2 ? " icon-tile--green" : ""}`}><Icon name={s.icon} size={22} /></span>
              <div>
                <span class="car-profile__num">Área {s.num}</span>
                <h3 class="car-profile__title">{areaName[s.key]}</h3>
              </div>
            </header>
            <ul class="car-profile__chips">
              {(roles[s.key] ?? []).map((r) => <li class="chip">{r}</li>)}
            </ul>
          </article>
        ))}
        <a href="#postular" class="car-profile car-profile--cta reveal" style="--d:.14s">
          <span class="car-profile__cta-title">¿Tu oficio no aparece?</span>
          <span class="car-profile__cta-text">Envíanos tu CV igualmente. Valoramos la experiencia de campo y las ganas de aprender.</span>
          <span class="car-profile__cta-link">Postularme <Icon name="arrow-right" size={16} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ HIRING PROCESS ============ -->
  <section class="car-section">
    <div class="container-nex car-process">
      <div class="car-process__intro reveal">
        <span class="eyebrow">Proceso de selección</span>
        <h2 class="title-split">Cuatro pasos, <span>claros y transparentes</span></h2>
        <p class="lead">Un proceso sencillo, con respeto por tu tiempo y con la seguridad como criterio desde el primer contacto.</p>
      </div>
      <ol class="car-stepper">
        {steps.map((s, i) => (
          <li class="car-step reveal" style={`--d:${i * 0.1}s`}>
            <span class="car-step__node" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="car-step__body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ APPLICATION ============ -->
  <section class="car-section car-section--apply" id="postular">
    <div class="container-nex car-apply">
      <div class="car-apply__intro reveal">
        <span class="eyebrow">Postúlate</span>
        <h2 class="title-split">Envía tu CV <span>y carta de intención</span></h2>
        <p class="lead">Aún no publicamos vacantes abiertas. Deja tu CV y carta de intención; te contactaremos cuando surja una posición acorde a tu perfil.</p>
        <div class="car-apply__alt">
          <span class="car-tile__icon"><Icon name="mail" size={20} /></span>
          <p>¿Prefieres el correo? Escríbenos a <a href={mailCv}>{CORP.email}</a> con tu CV adjunto.</p>
        </div>
        <div class="car-apply__privacy">
          <span class="car-tile__icon"><Icon name="lock" size={20} /></span>
          <p>Tus datos se usan solo para procesos de selección de NEX y se tratan con confidencialidad. Consulta nuestra <a href={privacyHref}>política de privacidad</a>.</p>
        </div>
      </div>
      <div class="car-apply__card reveal" style="--d:.1s">
        <ContactForm formName="careers" withUpload={true} defaultInquiry="talent" action="/es/gracias/" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .car-hero {
    position: relative;
    overflow: hidden;
    padding: 140px 0 clamp(64px, 8vw, 104px);
    background:
      radial-gradient(60% 70% at 100% 0%, rgba(104, 176, 90, 0.12), transparent 70%),
      radial-gradient(50% 60% at 0% 20%, rgba(47, 120, 180, 0.1), transparent 70%);
  }
  .car-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .car-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .car-crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--nex-gris);
  }
  .car-crumbs a {
    color: var(--nex-gris);
    text-decoration: none;
  }
  .car-crumbs a:hover {
    color: var(--nex-azul);
  }
  .car-hero__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.03;
    font-weight: 600;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }
  .car-hero__lead {
    max-width: 52ch;
    color: var(--nex-gris);
  }
  .car-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .car-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--nex-ink);
  }
  .car-hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .car-hero__facts :global(svg) {
    color: #3f8a4a;
  }

  .car-collage {
    position: relative;
    padding: 0 0 18% 12%;
  }
  .car-collage figure {
    margin: 0;
  }
  .car-collage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .car-collage__main {
    aspect-ratio: 4 / 3.4;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(16, 42, 67, 0.45);
    transform: rotate(1.2deg);
  }
  .car-collage__second {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 52%;
    aspect-ratio: 3 / 2;
    border-radius: 24px;
    overflow: hidden;
    border: 6px solid #fff;
    box-shadow: 0 30px 60px -24px rgba(16, 42, 67, 0.45);
    transform: rotate(-4deg);
    transition: transform 0.6s var(--nex-ease);
  }
  .car-collage:hover .car-collage__second {
    transform: rotate(-2deg) translateY(-4px);
  }
  .car-collage__badge {
    position: absolute;
    right: 0;
    bottom: 10%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.125rem 0.75rem 0.75rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(16, 42, 67, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 18px 50px -12px rgba(47, 120, 180, 0.35);
  }
  .car-collage__badge strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--nex-ink);
  }
  .car-collage__badge small {
    display: block;
    font-size: 0.8125rem;
    color: var(--nex-gris);
  }

  /* ---------- Sections ---------- */
  .car-section {
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .car-section--alt {
    background: linear-gradient(180deg, #eef4f8 0%, #f6f9fb 100%);
    border-block: 1px solid rgba(16, 42, 67, 0.06);
  }
  .car-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .car-head h2,
  .car-process__intro h2,
  .car-apply__intro h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .car-head--row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .car-head--row > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .car-head__aside {
    max-width: 44ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--nex-gris);
  }

  /* ---------- Bento ---------- */
  .car-bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .car-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.625rem;
    border-radius: 22px;
    background: #fff;
    border: 1px solid rgba(16, 42, 67, 0.081);
    transition: transform 0.5s var(--nex-ease), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .car-tile:hover {
    transform: translateY(-3px);
    border-color: rgba(47, 120, 180, 0.3);
    box-shadow: 0 18px 50px -12px rgba(47, 120, 180, 0.35);
  }
  .car-tile h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--nex-ink);
  }
  .car-tile p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--nex-gris);
  }
  .car-tile__icon {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--nex-azul);
    background: rgba(47, 120, 180, 0.08);
    flex: none;
  }
  .car-tile--hero {
    grid-column: span 2;
    grid-row: span 2;
    justify-content: flex-end;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background:
      radial-gradient(80% 70% at 100% 0%, rgba(104, 176, 90, 0.16), transparent 65%),
      radial-gradient(90% 80% at 0% 100%, rgba(47, 120, 180, 0.12), transparent 65%),
      #fff;
  }
  .car-tile--hero .icon-tile {
    position: absolute;
    top: clamp(1.75rem, 3vw, 2.5rem);
    left: clamp(1.75rem, 3vw, 2.5rem);
  }
  .car-tile--hero h3 {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    letter-spacing: -0.035em;
  }
  .car-tile--hero p {
    max-width: 44ch;
    font-size: 1rem;
  }
  .car-tile__metric {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 5rem;
  }
  .car-tile__metric span {
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.06em;
    background: linear-gradient(120deg, #17405f 0%, #2f78b4 50%, #3f9a5a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .car-tile__metric small {
    font-size: 1rem;
    color: var(--nex-gris);
  }
  .car-tile--wide {
    grid-column: span 2;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .car-tile--wide > div {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .car-tile--soft {
    background: rgba(255, 255, 255, 0.6);
  }
  .car-tile--accent {
    color: #fff;
    border-color: transparent;
    background:
      radial-gradient(70% 90% at 100% 100%, rgba(104, 176, 90, 0.55), transparent 70%),
      linear-gradient(140deg, #17405f 0%, #1c5a6e 60%, #2c6e4c 100%);
  }
  .car-tile--accent h3 {
    color: #fff;
  }
  .car-tile--accent p {
    color: rgba(255, 255, 255, 0.8);
  }
  .car-tile--accent .car-tile__icon {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
  }

  /* ---------- Profiles ---------- */
  .car-profiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .car-profile {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 22px;
    background: #fff;
    border: 1px solid rgba(16, 42, 67, 0.081);
    transition: transform 0.5s var(--nex-ease), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .car-profile:hover {
    transform: translateY(-3px);
    border-color: rgba(47, 120, 180, 0.3);
    box-shadow: 0 18px 50px -12px rgba(47, 120, 180, 0.35);
  }
  .car-profile__head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .car-profile__head .icon-tile {
    width: 46px;
    height: 46px;
  }
  .car-profile__num {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nex-gris);
  }
  .car-profile__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--nex-ink);
  }
  .car-profile__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .car-profile__chips .chip {
    font-size: 0.8125rem;
    padding: 0.3rem 0.75rem;
  }
  .car-profile--cta {
    justify-content: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #fff;
    border-color: transparent;
    background:
      radial-gradient(80% 90% at 100% 0%, rgba(104, 176, 90, 0.5), transparent 70%),
      linear-gradient(140deg, #2f78b4 0%, #17405f 100%);
  }
  .car-profile__cta-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .car-profile__cta-text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }
  .car-profile__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-weight: 600;
    color: #fff;
  }
  .car-profile--cta:hover .car-profile__cta-link :global(svg) {
    transform: translateX(3px);
  }
  .car-profile__cta-link :global(svg) {
    transition: transform 0.35s var(--nex-ease);
  }

