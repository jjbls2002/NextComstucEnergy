---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import CtaBand from "../../../components/CtaBand.astro";
import Icon from "../../../components/Icon.astro";
import { SERVICES, servicePath, navItems } from "../../../data/site";
import { SERVICE_CONTENT } from "../../../data/services";

const lang = "es";
const nav = navItems(lang);
---

<BaseLayout
  title="Servicios Petroleros | Workover, Saneamiento, Soldadura, Suministro, Ingeniería | NEX"
  description="Cinco líneas de servicio petrolero bajo un solo estándar: workover, saneamiento ambiental, soldadura industrial, suministro e ingeniería. Cumplimiento HSE e internacional."
  keywords="servicios petroleros venezuela, workover, saneamiento ambiental, soldadura industrial, suministro petrolero, ingeniería petrolera"
  esRest="/servicios/"
  enRest="/services/"
  breadcrumbs={[{ name: "Inicio", path: "/es/" }, { name: "Servicios" }]}
>
  <PageHero
    eyebrow="Servicios"
    title="Cinco líneas complementarias, un solo estándar"
    subtitle="Cada servicio se ejecuta bajo el mismo sistema documental, la misma disciplina HSE y el mismo marco de cumplimiento internacional."
    crumbs={[{ name: "Servicios" }]}
  />

  {SERVICES.map((s, i) => {
    const c = SERVICE_CONTENT[s.key][lang];
    const reversed = i % 2 === 1;
    return (
      <Section variant={reversed ? "off-white" : "white"}>
        <div class={`grid gap-10 lg:grid-cols-2 items-center ${reversed ? "" : ""}`}>
          <div class={reversed ? "lg:order-2" : ""}>
            <div class="flex items-center gap-4 mb-5">
              <span class="num-badge">{s.num}</span>
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-nex-fondo-alt text-nex-oro"><Icon name={c.icon} size={24} /></span>
            </div>
            <h2 class="text-2xl md:text-3xl mb-4">{s.title[lang]}</h2>
            <p class="text-nex-gris mb-5">{c.summary}</p>
            <a href={servicePath(lang, s.key)} class="inline-flex items-center gap-2 font-bold text-nex-blanco hover:text-nex-oro transition-colors">
              Conocer más
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
          <div class={reversed ? "lg:order-1" : ""}>
            <div class="card">
              <p class="text-sm font-bold uppercase tracking-wide text-nex-gris mb-4">Estándares aplicables</p>
              <div class="flex flex-wrap gap-2">
                {c.standards.slice(0, 8).map((st) => <span class="chip">{st}</span>)}
              </div>
            </div>
          </div>
        </div>
      </Section>
    );
  })}

  <CtaBand
    title="¿Qué necesita su operación?"
    text="Combinamos varias líneas para un mismo proyecto. Cuéntenos su alcance."
    ctaLabel="Solicitar propuesta"
    ctaHref={nav.contact}
  />
</BaseLayout>
