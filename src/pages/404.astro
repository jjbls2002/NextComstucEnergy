---
import "../styles/global.css";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 | NEX Comstuct & Energy C.A.</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F6F9FB" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap" />
  </head>
  <body class="glow justify-center">
    <div class="container-nex text-center py-20">
      <img src="/assets/logo-nex.png" alt="NEX Comstuct & Energy C.A." width="712" height="649" class="h-28 w-auto mx-auto mb-8" />
      <p class="text-brand text-7xl md:text-8xl leading-none">404</p>
      <h1 class="text-nex-blanco mt-4">Página no encontrada · Page not found</h1>
      <p class="mt-4 text-nex-gris max-w-md mx-auto">La página que busca no existe o fue movida. / The page you are looking for does not exist or was moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/es/" class="btn btn-on-navy">Ir al inicio</a>
        <a href="/en/" class="btn btn-ghost-navy">Go to home</a>
      </div>
    </div>
  </body>
</html>
