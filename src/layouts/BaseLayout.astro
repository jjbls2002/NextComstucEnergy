---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { getLangFromUrl, useTranslations } from "../utils/i18n";

interface Breadcrumb {
  name: string;
  path?: string;
}
interface ServiceLd {
  serviceType: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  esRest: string;
  enRest: string;
  image?: string;
  noindex?: boolean;
  organization?: boolean;
  breadcrumbs?: Breadcrumb[];
  service?: ServiceLd;
  /** extra top padding removed for full-bleed hero pages */
  bodyClass?: string;
}

const {
  title,
  description,
  keywords,
  esRest,
  enRest,
  image,
  noindex = false,
  organization = false,
  breadcrumbs,
  service,
  bodyClass = "",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={t.locale} dir={t.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#F6F9FB" />

    <!-- Satoshi by Indian Type Foundry via Fontshare (free for commercial use), font-display: swap -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <SEO
      title={title}
      description={description}
      keywords={keywords}
      esRest={esRest}
      enRest={enRest}
      lang={lang}
      image={image}
      noindex={noindex}
    />
    <StructuredData organization={organization} breadcrumbs={breadcrumbs} service={service} />
  </head>
  <body class={bodyClass}>
    <div class="page-bg" aria-hidden="true"></div>
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      // Scroll reveal: elements with .reveal fade up once they enter the viewport
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }),
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add("is-in"));
      }

      // Orb brightens and breathes while a link or button is hovered/focused
      if (document.querySelector(".orb-stage")) {
        const set = (on: boolean) => (on ? (document.body.dataset.orb = "strong") : delete document.body.dataset.orb);
        document.querySelectorAll<HTMLElement>("a, button").forEach((el) => {
          el.addEventListener("mouseenter", () => set(true));
          el.addEventListener("mouseleave", () => set(false));
          el.addEventListener("focus", () => set(true));
          el.addEventListener("blur", () => set(false));
        });
      }

      // Scroll-revealed statement: every character goes grey → white as the block scrolls through
      document.querySelectorAll<HTMLElement>("[data-statement]").forEach((block) => {
        const words = (block.textContent || "").trim().split(/\s+/);
        block.textContent = "";
        const chars: HTMLElement[] = [];
        words.forEach((w, i) => {
          const word = document.createElement("span");
          word.className = "word";
          [...w].forEach((c) => {
            const ch = document.createElement("span");
            ch.className = "ch";
            ch.textContent = c;
            word.appendChild(ch);
            chars.push(ch);
          });
          block.appendChild(word);
          if (i < words.length - 1) block.appendChild(document.createTextNode(" "));
        });
        const paint = () => {
          const r = block.getBoundingClientRect();
          const vh = window.innerHeight;
          const start = vh * 0.85;
          const end = vh * 0.25;
          const p = Math.min(1, Math.max(0, (start - r.top) / (start - end)));
          const lit = Math.round(p * chars.length);
          chars.forEach((c, i) => (c.style.color = i < lit ? "var(--nex-ink)" : ""));
        };
        paint();
        window.addEventListener("scroll", paint, { passive: true });
        window.addEventListener("resize", paint);
      });
    </script>
  </body>
</html>
