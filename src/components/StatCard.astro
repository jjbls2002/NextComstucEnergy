---
interface Props {
  value: string;
  label: string;
  variant?: "navy" | "light";
}
const { value, label } = Astro.props;
---

<div class="frame reveal h-full">
  <div class="card h-full text-center py-9">
    <div class="text-brand text-5xl md:text-6xl tracking-tight leading-none">{value}</div>
    <div class="mt-4 text-[15px] leading-snug text-nex-gris">{label}</div>
  </div>
</div>
