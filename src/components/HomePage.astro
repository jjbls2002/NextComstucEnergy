---
import Hero from "./Hero.astro";
import Section from "./Section.astro";
import StatCard from "./StatCard.astro";
import CtaBand from "./CtaBand.astro";
import Icon from "./Icon.astro";
import { SERVICES, servicePath, navItems } from "../data/site";
import type { Lang } from "../utils/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const nav = navItems(lang);

const COPY = {
  es: {
    hero: {
      title: "Servicios petroleros",
      strong: "de talla internacional.",
      subtitle:
        "Empresa venezolana con sistema documental auditable, cumplimiento FCPA/UKBA integrado y disciplina HSE de clase mundial.",
      primary: "Solicitar propuesta",
      secondary: "Conocer NEX",
      trustLabel: "Estándares con los que trabajamos",
    },
    about: {
      badge: "Quiénes somos",
      statement:
        "NEX integra cinco líneas de servicio petrolero bajo un solo estándar: documentación auditable, cumplimiento internacional y disciplina HSE en cada operación, desde el primer día.",
      cta: "Conocer NEX",
    },
    ops: {
      badge: "Líneas de servicio",
      title: "Cinco capacidades,",
      muted: "un solo estándar.",
      lead: "Un mismo contratista para intervenir el pozo, remediar el entorno, soldar, suministrar y gerenciar el proyecto, con la misma exigencia técnica en cada frente.",
      more: "Conocer más",
      all: "Ver todas las líneas de servicio",
      mediaCaption: "Construyendo el futuro, impulsando la energía.",
    },
    commitments: {
      badge: "Compromisos cuantitativos",
      title: "Lo que medimos,",
      muted: "lo cumplimos.",
    },
    why: {
      badge: "¿Por qué NEX?",
      title: "Cinco diferenciadores",
      muted: "que un evaluador reconoce.",
    },
    markets: { badge: "Mercado objetivo", title: "A quién", muted: "servimos." },
    system: { badge: "Nuestro sistema en cifras", title: "Institucionalidad", muted: "medible." },
    closing: {
      title: "Conversemos sobre su próxima operación.",
      text: "Un evaluador serio merece una respuesta seria. Cuéntenos su necesidad y prepararemos una propuesta técnica ajustada a su operación.",
      cta: "Solicitar propuesta",
      secondary: "Ver servicios",
    },
  },
  en: {
    hero: {
      title: "Oil & gas services",
      strong: "at international standard.",
      subtitle:
        "A Venezuelan company with an auditable documentary system, integrated FCPA/UKBA compliance and world-class HSE discipline.",
      primary: "Request proposal",
      secondary: "Learn about NEX",
      trustLabel: "Standards we work to",
    },
    about: {
      badge: "Who we are",
      statement:
        "NEX brings five oil & gas service lines under a single standard: auditable documentation, international compliance and HSE discipline in every operation, from day one.",
      cta: "Learn about NEX",
    },
    ops: {
      badge: "Service lines",
      title: "Five capabilities,",
      muted: "one standard.",
      lead: "One contractor to intervene the well, remediate the site, weld, supply and manage the project, with the same technical rigor on every front.",
      more: "Learn more",
      all: "View all service lines",
      mediaCaption: "Building the future, powering energy.",
    },
    commitments: {
      badge: "Quantitative commitments",
      title: "What we measure,",
      muted: "we deliver.",
    },
    why: {
      badge: "Why NEX?",
      title: "Five differentiators",
      muted: "an evaluator recognizes.",
    },
    markets: { badge: "Target market", title: "Who", muted: "we serve." },
    system: { badge: "Our system in numbers", title: "Measurable", muted: "institutionality." },
    closing: {
      title: "Let's talk about your next operation.",
      text: "A serious evaluator deserves a serious answer. Tell us what you need and we will prepare a technical proposal tailored to your operation.",
      cta: "Request proposal",
      secondary: "View services",
    },
  },
}[lang];

const standards = ["API Spec 16A", "IWCF", "IADC", "ASME IX", "AWS D1.1", "ISO 9001", "ISO 14001", "ISO 45001", "FCPA", "UK Bribery Act"];

const serviceCopy = {
  workover: {
    icon: "wrench",
    keys: ["IWCF", "IADC", "API 16A"],
    desc: {
      es: "Intervención y reacondicionamiento de pozos con personal certificado IWCF/IADC, control de pozo garantizado y equipos conforme a API Spec 16A.",
      en: "Well intervention and workover with IWCF/IADC-certified personnel, guaranteed well control and equipment compliant with API Spec 16A.",
    },
  },
  environmental: {
    icon: "leaf",
    keys: ["Biorremediación", "Landfarming", "MPPEA"],
    desc: {
      es: "Remediación de suelos y aguas contaminadas con hidrocarburos: biorremediación, landfarming y disposición controlada con certificación MPPEA.",
      en: "Remediation of hydrocarbon-contaminated soil and water: bioremediation, landfarming and controlled disposal with MPPEA certification.",
    },
  },
  welding: {
    icon: "flame",
    keys: ["ASME IX", "AWS D1.1", "CWI"],
    desc: {
      es: "Soldadura industrial certificada ASME IX y AWS D1.1, con soldadores calificados, inspección CWI y ensayos no destructivos disponibles.",
      en: "ASME IX and AWS D1.1 certified industrial welding, with qualified welders, CWI inspection and non-destructive testing available.",
    },
  },
  supply: {
    icon: "package",
    keys: ["MTR", "Trazabilidad", "Proveedores"],
    desc: {
      es: "Suministro de equipos y materiales para operaciones petroleras con trazabilidad MTR y una red de proveedores certificada.",
      en: "Supply of equipment and materials for oil operations with MTR traceability and a certified supplier network.",
    },
  },
  engineering: {
    icon: "compass",
    keys: ["Diseño", "Supervisión", "Gerencia"],
    desc: {
      es: "Ingeniería y consultoría técnica: diseño operativo, supervisión, gerencia de proyectos y consultoría especializada con personal senior.",
      en: "Engineering and technical consulting: operational design, supervision, project management and specialized consulting with senior staff.",
    },
  },
} as const;

const keysEn: Record<string, string> = {
  Biorremediación: "Bioremediation",
  Trazabilidad: "Traceability",
  Proveedores: "Suppliers",
  Diseño: "Design",
  Supervisión: "Supervision",
  Gerencia: "Management",
};

const commitments = {
  es: [
    { value: "< 1.0", label: "TRIR por 200.000 hh" },
    { value: "0", label: "Fatalidades" },
    { value: "0", label: "Derrames no contenidos" },
    { value: "100%", label: "Personal con inducción HSE vigente" },
  ],
  en: [
    { value: "< 1.0", label: "TRIR per 200,000 man-hours" },
    { value: "0", label: "Fatalities" },
    { value: "0", label: "Uncontained spills" },
    { value: "100%", label: "Personnel with current HSE induction" },
  ],
}[lang];

const differentiators = {
  es: [
    { title: "Sistema documental desde el día 1", text: "48 documentos auditables y procesos formalizados que sostienen cada operación con trazabilidad completa." },
    { title: "Cumplimiento internacional integrado", text: "FCPA, UK Bribery Act, OFAC/sanciones y Principios Rectores ONU incorporados a la gestión, no añadidos después." },
    { title: "HSE no negociable y medido", text: "Metas cuantitativas (TRIR < 1.0, cero fatalidades, cero derrames) con matrices IPER por línea de servicio." },
    { title: "Cinco líneas bajo un solo paraguas", text: "Workover, saneamiento, soldadura, suministro e ingeniería integrados para un mismo cliente y un mismo estándar." },
    { title: "Ubicación estratégica", text: "Valle de la Pascua, equidistante de la Faja del Orinoco, la Cuenca Oriental y la Cuenca Barinas-Apure." },
  ],
  en: [
    { title: "Documentary system from day 1", text: "48 auditable documents and formalized processes that support every operation with full traceability." },
    { title: "Integrated international compliance", text: "FCPA, UK Bribery Act, OFAC/sanctions and UN Guiding Principles built into management, not bolted on afterwards." },
    { title: "Non-negotiable, measured HSE", text: "Quantitative targets (TRIR < 1.0, zero fatalities, zero spills) with IPER matrices per service line." },
    { title: "Five lines under one umbrella", text: "Workover, remediation, welding, supply and engineering integrated for a single client and a single standard." },
    { title: "Strategic location", text: "Valle de la Pascua, equidistant from the Orinoco Belt, the Eastern Basin and the Barinas-Apure Basin." },
  ],
}[lang];

const markets = {
  es: [
    { icon: "building", title: "PDVSA + filiales", text: "Proveedor calificable para PDVSA y sus empresas mixtas, con sistema documental orientado a la evaluación técnica." },
    { icon: "globe", title: "IOC en Venezuela", text: "Operadoras internacionales presentes en el país, con exigencias de cumplimiento y HSE de estándar global." },
    { icon: "map-pin", title: "Mercado regional", text: "Proyección hacia Colombia, Guyana y Trinidad y Tobago, mercados de hidrocarburos en expansión." },
  ],
  en: [
    { icon: "building", title: "PDVSA + subsidiaries", text: "Qualifiable supplier for PDVSA and its joint ventures, with a documentary system geared to technical evaluation." },
    { icon: "globe", title: "IOCs in Venezuela", text: "International operators present in the country, with global-standard compliance and HSE requirements." },
    { icon: "map-pin", title: "Regional market", text: "Projection toward Colombia, Guyana and Trinidad and Tobago, expanding hydrocarbon markets." },
  ],
}[lang];

const systemStats = {
  es: [
    { value: "48", label: "documentos auditables" },
    { value: "7", label: "pilares del Sistema Integrado de Gestión" },
    { value: "5", label: "líneas de servicio" },
    { value: "3", label: "mercados objetivo" },
  ],
  en: [
    { value: "48", label: "auditable documents" },
    { value: "7", label: "pillars of the Integrated Management System" },
    { value: "5", label: "service lines" },
    { value: "3", label: "target markets" },
  ],
}[lang];
---

<Hero
  title={COPY.hero.title}
  strong={COPY.hero.strong}
  subtitle={COPY.hero.subtitle}
  primary={{ label: COPY.hero.primary, href: nav.contact }}
  secondary={{ label: COPY.hero.secondary, href: nav.about }}
  trust={{ label: COPY.hero.trustLabel, items: standards }}
/>

<!-- Statement: characters light up as the section scrolls -->
<section class="about-block rule-bottom">
  <div class="container-nex text-center flex flex-col items-center">
    <p class="eyebrow reveal">{COPY.about.badge}</p>
    <p class="statement about-block__statement" data-statement>{COPY.about.statement}</p>
    <ul class="about-block__pills reveal">
      {SERVICES.map((s) => (
        <li>
          <a href={servicePath(lang, s.key)} class="pill">
            <Icon name={serviceCopy[s.key].icon} size={16} />
            {s.title[lang]}
          </a>
        </li>
      ))}
    </ul>
    <a href={nav.about} class="btn btn-primary mt-11 reveal">
      {COPY.about.cta}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>

<!-- Service lines: sticky framed brand panel + stacked cards -->
<section class="ops dots rule-bottom" data-ops>
  <div class="ops__inner container-nex">
    <div class="ops__content">
      <div class="ops__head reveal">
        <p class="eyebrow">{COPY.ops.badge}</p>
        <h2 class="title-split mt-7">
          {COPY.ops.title}
          <span>{COPY.ops.muted}</span>
        </h2>
        <p class="lead mt-6 max-w-[560px]">{COPY.ops.lead}</p>
      </div>
      <ul class="ops__cards">
        {SERVICES.map((s) => {
          const c = serviceCopy[s.key];
          return (
            <li class="ops__card frame reveal" data-ops-card>
              <a href={servicePath(lang, s.key)} class="card ops__svc group">
                <div class="flex items-center justify-between">
                  <span class="icon-tile">
                    <Icon name={c.icon} size={24} />
                  </span>
                  <span class="chip">{s.num}</span>
                </div>
                <h3 class="mt-7 text-[19px]">{s.title[lang]}</h3>
                <span class="section-rule my-5" />
                <p class="text-[#5b6872] leading-relaxed">{c.desc[lang]}</p>
                <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
                  <p class="text-sm font-medium text-nex-azul-light">
                    {c.keys.map((k, i) => (
                      <>
                        {i > 0 && <span class="mx-1.5 opacity-60">·</span>}
                        {lang === "en" ? keysEn[k] ?? k : k}
                      </>
                    ))}
                  </p>
                  <span class="inline-flex items-center gap-1.5 text-sm font-medium text-nex-gris transition-colors group-hover:text-nex-blanco">
                    {COPY.ops.more}
                    <Icon name="arrow-right" size={15} class="transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
      <a href={nav.services} class="btn btn-secondary mt-8 self-start reveal">
        {COPY.ops.all}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="ops__media" data-ops-media>
      <div class="frame">
        <div class="ops__panel">
          <img src="/assets/logo-nex.png" alt="NEX Comstuct & Energy C.A." width="712" height="649" loading="lazy" />
          <p>{COPY.ops.mediaCaption}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<Section variant="dark" eyebrow={COPY.commitments.badge} title={COPY.commitments.title} subtitle={COPY.commitments.muted} center>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {commitments.map((c) => <StatCard value={c.value} label={c.label} />)}
  </div>
</Section>

<!-- Differentiators: steps that light up as they enter -->
<Section eyebrow={COPY.why.badge} title={COPY.why.title} subtitle={COPY.why.muted} center>
  <ol class="steps">
    {differentiators.map((d, i) => (
      <li class="step reveal" style={`--d:${i * 0.08}s`}>
        <span class="step__node">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="step__title">{d.title}</h3>
        <p class="step__text">{d.text}</p>
      </li>
    ))}
  </ol>
</Section>

<Section variant="navy" eyebrow={COPY.markets.badge} title={COPY.markets.title} subtitle={COPY.markets.muted} center>
  <div class="grid gap-5 md:grid-cols-3">
    {markets.map((m, i) => (
      <div class="frame reveal" style={`--d:${i * 0.08}s`}>
        <article class="card h-full">
          <span class={`icon-tile ${i === 2 ? "icon-tile--green" : ""}`}>
            <Icon name={m.icon} size={24} />
          </span>
          <h3 class="mt-7 text-[19px]">{m.title}</h3>
          <span class="section-rule my-5" />
          <p class="text-[#5b6872] leading-relaxed">{m.text}</p>
        </article>
      </div>
    ))}
  </div>
</Section>

<Section variant="dark" eyebrow={COPY.system.badge} title={COPY.system.title} subtitle={COPY.system.muted} center>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {systemStats.map((s) => <StatCard value={s.value} label={s.label} />)}
  </div>
</Section>

<CtaBand
  title={COPY.closing.title}
  text={COPY.closing.text}
  ctaLabel={COPY.closing.cta}
  ctaHref={nav.contact}
  secondaryLabel={COPY.closing.secondary}
  secondaryHref={nav.services}
/>

<style>
  /* ---------- Statement ---------- */
  .about-block {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 140px 0 150px;
  }
  .about-block::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 42%;
    left: 50%;
    width: min(980px, 140vw);
    height: 560px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(47, 120, 180, 0.22), rgba(104, 176, 90, 0.06) 55%, transparent);
    filter: blur(40px);
    pointer-events: none;
  }
  .about-block__statement {
    max-width: 1000px;
    margin-top: 32px;
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 1.22;
    letter-spacing: -0.03em;
    color: var(--nex-ink);
    text-wrap: balance;
  }
  .about-block__pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 820px;
    margin-top: 40px;
  }

  /* ---------- Service lines ---------- */
  .ops {
    position: relative;
    overflow-x: clip;
    padding: 130px 0 150px;
  }
  .ops__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: 88px;
    align-items: start;
  }
  .ops__content {
    display: flex;
    flex-direction: column;
  }
  .ops__cards {
    list-style: none;
    display: grid;
    gap: 22px;
    margin-top: 56px;
  }
  .ops__svc {
    display: block;
    transition:
      opacity 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease,
      transform 0.5s var(--nex-ease);
  }
  .ops.is-focus .ops__svc {
    opacity: 0.45;
  }
  .ops.is-focus .ops__card.is-active .ops__svc {
    opacity: 1;
    border-color: rgba(109, 180, 217, 0.38);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(109, 180, 217, 0.08),
      0 18px 50px -12px rgba(47, 120, 180, 0.45);
    transform: translateX(6px);
  }
  .ops__media {
    position: sticky;
    top: 110px;
  }
  .ops__media::before {
    content: "";
    position: absolute;
    inset: -18% -16%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(47, 120, 180, 0.4), rgba(104, 176, 90, 0.14) 60%, transparent 80%);
    filter: blur(36px);
    pointer-events: none;
  }
  .ops__media.is-pulsing::before {
    animation: halo-pulse 1.1s var(--nex-ease);
  }
  .ops__media .frame {
    position: relative;
    background: rgba(255, 255, 255, 0.6);
  }
  .ops__media .frame::after {
    content: "";
    position: absolute;
    left: 30%;
    right: 30%;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(109, 180, 217, 0.8), rgba(104, 176, 90, 0.6), transparent);
  }
  .ops__panel {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: 12%;
    border-radius: 19px;
    background:
      radial-gradient(80% 70% at 50% 40%, rgba(47, 120, 180, 0.22), transparent 70%),
      linear-gradient(180deg, #ffffff, #eef4f8);
    border: 1px solid rgba(16, 42, 67, 0.069);
  }
  .ops__panel img {
    width: 78%;
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(16, 42, 67, 0.18));
  }
  .ops__panel p {
    font-size: 15px;
    color: #55626c;
    text-align: center;
  }
  @keyframes halo-pulse {
    0% {
      transform: scale(1);
      filter: blur(36px) brightness(1);
    }
    35% {
      transform: scale(1.08);
      filter: blur(36px) brightness(1.8);
    }
    100% {
      transform: scale(1);
      filter: blur(36px) brightness(1);
    }
  }
  @media (max-width: 960px) {
    .ops {
      padding: 96px 0 110px;
    }
    .ops__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .ops__content {
      display: contents;
    }
    .ops__head {
      order: 1;
    }
    .ops__media {
      position: relative;
      top: auto;
      order: 2;
      margin-top: 40px;
    }
    .ops__panel {
      aspect-ratio: 4 / 3;
    }
    .ops__panel img {
      width: 52%;
    }
    .ops__cards {
      order: 3;
      margin-top: 22px;
    }
    .ops__content > .btn {
      order: 4;
    }
    .ops.is-focus .ops__card.is-active .ops__svc {
      transform: none;
    }
  }

  /* ---------- Steps ---------- */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px;
    position: relative;
    text-align: left;
  }
  .steps::before {
    content: "";
    position: absolute;
    top: 28px;
    left: 28px;
    right: 28px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--nex-azul), var(--nex-azul-light), var(--nex-verde));
    box-shadow: 0 0 14px rgba(109, 180, 217, 0.45);
    opacity: 0.55;
  }
  .step__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: #5c6873;
    background: #ffffff;
    border: 1px solid rgba(16, 42, 67, 0.115);
    box-shadow: 0 0 0 6px var(--nex-fondo);
    transition:
      color 0.6s ease,
      background 0.6s ease,
      border-color 0.6s ease,
      box-shadow 0.6s ease;
    transition-delay: calc(var(--d, 0s) + 0.2s);
  }
  .step.is-in .step__node,
  :global(html:not(.js)) .step__node {
    color: #fff;
    background: radial-gradient(circle at 35% 30%, #5aa6d4, var(--nex-azul) 72%);
    border-color: rgba(169, 214, 238, 0.45);
    box-shadow:
      0 0 0 6px var(--nex-fondo),
      0 0 0 7px rgba(109, 180, 217, 0.35),
      0 10px 24px rgba(47, 120, 180, 0.35);
  }
  .step__title {
    margin-top: 24px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--nex-ink);
  }
  .step__text {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: #5b6872;
  }
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 36px;
      max-width: 520px;
      margin: 0 auto;
    }
    .steps::before {
      top: 28px;
      bottom: 28px;
      left: 27px;
      right: auto;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--nex-azul), var(--nex-azul-light), var(--nex-verde));
    }
    .step {
      display: grid;
      grid-template-columns: 56px 1fr;
      column-gap: 22px;
    }
    .step__node {
      grid-row: 1 / span 2;
    }
    .step__title {
      margin-top: 4px;
    }
  }
</style>

<script>
  // Service cards: the card nearest the middle of the screen becomes active, the rest dim
  const ops = document.querySelector<HTMLElement>("[data-ops]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-ops-card]"));
  const media = document.querySelector<HTMLElement>("[data-ops-media]");
  if (ops && cards.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let active: HTMLElement | null = null;
    const update = () => {
      const r = ops.getBoundingClientRect();
      const inView = r.top < window.innerHeight * 0.6 && r.bottom > window.innerHeight * 0.4;
      ops.classList.toggle("is-focus", inView);
      if (!inView) return;
      const mid = window.innerHeight / 2;
      let best = cards[0];
      let dist = Infinity;
      cards.forEach((c) => {
        const b = c.getBoundingClientRect();
        const d = Math.abs(b.top + b.height / 2 - mid);
        if (d < dist) {
          dist = d;
          best = c;
        }
      });
      if (best !== active) {
        active?.classList.remove("is-active");
        best.classList.add("is-active");
        active = best;
        if (media) {
          media.classList.remove("is-pulsing");
          void media.offsetWidth;
          media.classList.add("is-pulsing");
        }
      }
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
