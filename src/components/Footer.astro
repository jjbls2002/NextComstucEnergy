---
import { getLangFromUrl, useTranslations } from "../utils/i18n";
import { navItems, SERVICES, servicePath, CORP } from "../data/site";
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const nav = navItems(lang);
const es = lang === "es";

const legal = {
  privacy: es ? "/es/privacidad/" : "/en/privacy/",
  terms: es ? "/es/terminos/" : "/en/terms/",
  cookies: es ? "/es/cookies/" : "/en/cookies/",
};

const company = [
  { href: nav.about, label: t.nav.about },
  { href: nav.hse, label: t.nav.hse },
  { href: nav.sig, label: t.nav.sig },
  { href: nav.investors, label: t.nav.investors },
  { href: nav.careers, label: t.nav.careers },
  { href: nav.contact, label: t.nav.contact },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={nav.home} class="inline-block" aria-label={es ? "Inicio de NEX" : "NEX home"}>
          <img src="/assets/logo-nex.png" alt="NEX Comstuct & Energy C.A." width="712" height="649" class="site-footer__logo" loading="lazy" />
        </a>
        <p class="site-footer__tagline">{CORP.slogan[lang]}</p>
        <p class="site-footer__desc">{t.footer.tagline}</p>
        <div class="mt-6 flex items-center gap-3">
          <a href={CORP.linkedin} aria-label="LinkedIn" class="site-footer__social"><Icon name="linkedin" size={18} /></a>
          <a href={CORP.instagram} aria-label="Instagram" class="site-footer__social"><Icon name="instagram" size={18} /></a>
        </div>
      </div>

      <div class="site-footer__col">
        <h2>{t.nav.services}</h2>
        <ul>
          {SERVICES.map((s) => (
            <li><a href={servicePath(lang, s.key)}>{s.title[lang]}</a></li>
          ))}
          <li><a href={nav.services}>{t.nav.servicesMenu}</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h2>{es ? "Empresa" : "Company"}</h2>
        <ul>
          {company.map((c) => (
            <li><a href={c.href}>{c.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="site-footer__col">
        <h2>{t.footer.corporateData}</h2>
        <ul>
          <li class="text-[#33414c]">{CORP.legalName}</li>
          <li>{t.footer.rif} {CORP.rif}</li>
          <li>{CORP.addressLine}, {CORP.city}, {CORP.region}, {CORP.countryName}</li>
          <li><a href={`mailto:${CORP.email}`} class="break-all">{CORP.email}</a></li>
          <li><a href={`tel:${CORP.phone.replace(/[^\d+]/g, "")}`}>{CORP.phone}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© <span data-year>2026</span> {CORP.legalName}. {t.common.allRightsReserved}</p>
      <div class="site-footer__end">
      <nav class="site-footer__legal" aria-label="Legal">
        <a href={legal.terms}>{t.footer.terms}</a>
        <a href={legal.privacy}>{t.footer.privacy}</a>
        <a href={legal.cookies}>{t.footer.cookies}</a>
        <button type="button" data-open-cookie-prefs>{t.common.changeCookiePrefs}</button>
      </nav>
      <LanguageSwitcher />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 72px 16px 32px;
    border-top: 1px solid rgba(16, 42, 67, 0.081);
  }
  .site-footer::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -160px;
    left: 50%;
    width: 700px;
    height: 320px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(47, 120, 180, 0.18), transparent 75%);
    filter: blur(30px);
    pointer-events: none;
  }
  .site-footer__inner {
    max-width: 1168px;
    margin: 0 auto;
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 0.8fr));
    gap: 40px;
  }
  .site-footer__logo {
    width: auto;
    height: 104px;
  }
  .site-footer__tagline {
    margin-top: 18px;
    font-size: 16px;
    font-weight: 500;
    color: #33414c;
  }
  .site-footer__desc {
    max-width: 340px;
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: #5c6873;
  }
  .site-footer__social {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #5b6872;
    background: rgba(16, 42, 67, 0.034);
    border: 1px solid rgba(16, 42, 67, 0.115);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.35s var(--nex-ease);
  }
  .site-footer__social:hover {
    color: var(--nex-ink);
    border-color: rgba(109, 180, 217, 0.5);
    transform: translateY(-2px);
  }
  .site-footer__col h2 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--nex-ink);
  }
  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 18px;
    font-size: 15px;
    color: #55626c;
  }
  .site-footer__col a {
    transition: color 0.2s ease;
  }
  .site-footer__col a:hover {
    color: var(--nex-ink);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgba(16, 42, 67, 0.081);
    font-size: 14px;
    color: #5c6873;
  }
  .site-footer__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }
  .site-footer__legal a,
  .site-footer__legal button {
    color: #55626c;
    background: none;
    border: none;
    font: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .site-footer__legal a:hover,
  .site-footer__legal button:hover {
    color: var(--nex-ink);
  }
  @media (max-width: 860px) {
    .site-footer {
      padding: 56px 16px 28px;
    }
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 36px 24px;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
    .site-footer__bottom {
      margin-top: 44px;
    }
  }
  @media (max-width: 480px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll("[data-year]").forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
