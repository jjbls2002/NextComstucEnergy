---
import Icon from "./Icon.astro";
interface Props {
  title: string;
  text?: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const { title, text, ctaLabel, ctaHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="closing">
  <div class="container-nex text-center flex flex-col items-center">
    <div class="closing__headline reveal">
      <div class="orb-stage" aria-hidden="true">
        <div class="orb-breath">
          <div class="orb-pulse">
            <div class="orb-wrap">
              <div class="orb"></div>
              <div class="orb-core"></div>
            </div>
          </div>
        </div>
      </div>
      <h2 class="closing__title text-grad-brand">{title}</h2>
    </div>
    {text && <p class="closing__lead reveal">{text}</p>}
    <div class="closing__actions reveal">
      <a href={ctaHref} class="btn btn-primary">
        {ctaLabel}
        <Icon name="arrow-right" size={16} />
      </a>
      {secondaryLabel && secondaryHref && <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding: 160px 0 170px;
  }
  .closing__headline {
    position: relative;
  }
  .closing__title {
    max-width: 820px;
    font-weight: 400;
    font-size: clamp(36px, 5.2vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .closing__lead {
    max-width: 540px;
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.55;
    color: #e6edf1;
    text-wrap: balance;
  }
  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }
  @media (max-width: 860px) {
    .closing {
      padding: 120px 0 130px;
    }
    .closing__lead {
      font-size: 16px;
    }
  }
</style>
