---
import Icon from "./Icon.astro";
import CtaBand from "./CtaBand.astro";
import { SERVICE_CONTENT } from "../data/services";
import { navItems, servicePath, SERVICES } from "../data/site";
import { useTranslations } from "../utils/i18n";
import type { Lang } from "../utils/i18n";
import type { ServiceKey } from "../data/site";

interface Props {
  serviceKey: ServiceKey;
  lang: Lang;
}
const { serviceKey, lang } = Astro.props;
const t = useTranslations(lang);
const nav = navItems(lang);
const c = SERVICE_CONTENT[serviceKey][lang];
const meta = SERVICES.find((s) => s.key === serviceKey)!;
const others = SERVICES.filter((s) => s.key !== serviceKey);
const es = lang === "es";

const L = {
  services: es ? "Servicios" : "Services",
  process: es ? "Cómo trabajamos" : "How we work",
  processSub: es ? "Un método claro, de principio a fin." : "A clear method, start to finish.",
  contracts: es ? "Modalidades de contratación" : "Contract models",
  why: es ? "Por qué con NEX" : "Why NEX",
  related: es ? "Otros servicios" : "Other services",
  more: es ? "Ver servicio" : "View service",
  cta: es ? "Solicite una propuesta técnica para este servicio." : "Request a technical proposal for this service.",
  talk: es ? "Hablemos de su proyecto" : "Let's talk about your project",
};

const crumbs = [
  { name: t.nav.home, href: nav.home },
  { name: L.services, href: nav.services },
  { name: meta.title[lang] },
];
const featureIcons: Record<ServiceKey, string[]> = {
  civil: ["building", "map-pin", "droplet", "refresh-cw"],
  mechanical: ["zap", "refresh-cw", "layers", "package"],
  pipelines: ["pipe", "pipe", "pipe", "pipe"],
  environmental: ["shield", "droplet", "package", "leaf"],
  chemicals: ["flask", "shield-check", "droplet", "package"],
  logistics: ["truck", "package", "zap", "building"],
  staffing: ["wrench", "hard-hat", "clipboard-check", "file-text"],
};
const ficons = featureIcons[serviceKey];
---

<!-- ================= HERO (three layouts) ================= -->
{c.variant === "split" && (
  <section class="sd-hero sd-hero--split">
    <div class="container-nex sd-split">
      <div class="sd-split__text">
        <p class="eyebrow mt-7 anim-in" style="animation-delay:.05s">{c.kicker}</p>
        <h1 class="sd-title text-grad-brand anim-in" style="animation-delay:.1s">{c.hero}</h1>
        <p class="sd-sub anim-in" style="animation-delay:.18s">{c.heroSub}</p>
        <div class="sd-actions anim-in" style="animation-delay:.26s">
          <a href={nav.contact} class="btn btn-primary">{t.common.requestProposal}<Icon name="arrow-right" size={16} /></a>
          <a href="#alcance" class="btn btn-secondary">{c.capsTitle}</a>
        </div>
      </div>
      <figure class="sd-split__media anim-in" style="animation-delay:.15s">
        <div class="frame">
          <img src={meta.image} alt={meta.title[lang]} width="1200" height="900" loading="eager" />
        </div>
        <figcaption class="sd-float">
          <span class="icon-tile"><Icon name={meta.icon} size={22} /></span>
          <span>
            <strong>{meta.num}</strong>
            <span>{meta.short[lang]}</span>
          </span>
        </figcaption>
      </figure>
    </div>
  </section>
)}

{c.variant === "immersive" && (
  <section class="sd-hero sd-hero--immersive">
    <img class="sd-immersive__bg" src={meta.image} alt={meta.title[lang]} width="1800" height="1200" loading="eager" />
    <div class="sd-immersive__shade" aria-hidden="true"></div>
    <div class="container-nex sd-immersive">
      <div class="sd-immersive__text">
        <p class="sd-kicker-light anim-in" style="animation-delay:.05s">{c.kicker}</p>
        <h1 class="sd-title sd-title--light anim-in" style="animation-delay:.1s">{c.hero}</h1>
        <p class="sd-sub sd-sub--light anim-in" style="animation-delay:.18s">{c.heroSub}</p>
        <div class="sd-actions anim-in" style="animation-delay:.26s">
          <a href={nav.contact} class="btn btn-primary">{t.common.requestProposal}<Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <ul class="sd-glass anim-in" style="animation-delay:.32s">
        {c.highlights.map((h) => (
          <li>
            <Icon name="check-circle" size={20} />
            <span><strong>{h.title}</strong>{h.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{c.variant === "editorial" && (
  <section class="sd-hero sd-hero--editorial">
    <div class="container-nex">
      <div class="sd-editorial">
        <div>
          <p class="eyebrow anim-in" style="animation-delay:.05s">{c.kicker}</p>
          <h1 class="sd-title sd-title--xl text-grad-brand anim-in" style="animation-delay:.1s">{c.hero}</h1>
        </div>
        <div class="sd-editorial__aside anim-in" style="animation-delay:.2s">
          <p class="sd-sub">{c.heroSub}</p>
          <a href={nav.contact} class="btn btn-primary mt-7">{t.common.requestProposal}<Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <div class="sd-editorial__media anim-in" style="animation-delay:.25s">
        <img src={meta.image} alt={meta.title[lang]} width="1800" height="900" loading="eager" />
      </div>
    </div>
  </section>
)}

<!-- ================= INTRO + HIGHLIGHTS ================= -->
<section class="sd-intro">
  <div class="container-nex">
    <p class="sd-intro__text reveal">{c.intro}</p>
    {c.variant !== "immersive" && (
      <ul class="sd-highlights">
        {c.highlights.map((h, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="sd-highlights__n">0{i + 1}</span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<!-- ================= SIGNATURE SECTION (unique per service) ================= -->
{serviceKey === "civil" && (
  <section class="sd-sig">
    <div class="container-nex sd-mosaic">
      <div class="sd-mosaic__media reveal">
        <img src="/images/obras-civiles-2.webp" alt={es ? "Cuadrillas trabajando en una obra civil" : "Crews working on a civil works site"} width="1200" height="900" loading="lazy" />
      </div>
      <div>
        <h2 class="title-split reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
        <div class="sd-mosaic__grid">
          {c.feature.items.map((it, i) => (
            <div class="frame reveal" style={`--d:${i * 0.07}s`}>
              <article class="card h-full">
                <span class="icon-tile"><Icon name={ficons[i]} size={22} /></span>
                <h3 class="mt-5 text-[18px]">{it.title}</h3>
                <p class="mt-2 text-[15px] text-nex-gris leading-relaxed">{it.text}</p>
              </article>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{serviceKey === "mechanical" && (
  <section class="sd-sig band-dark relative overflow-x-clip py-24 md:py-28">
    <div class="container-nex">
      <h2 class="title-split text-center reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
      <div class="sd-equip">
        {c.feature.items.map((it, i) => (
          <div class="frame reveal" style={`--d:${i * 0.07}s`}>
            <article class="card h-full">
              <span class="sd-equip__n">0{i + 1}</span>
              <Icon name={ficons[i]} size={26} class="sd-equip__icon" />
              <h3 class="mt-6 text-[19px] sd-h-light">{it.title}</h3>
              <p class="mt-2 text-[15px] text-nex-gris leading-relaxed">{it.text}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{serviceKey === "pipelines" && (
  <section class="sd-sig">
    <div class="container-nex">
      <div class="text-center flex flex-col items-center">
        <h2 class="title-split reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
      </div>
      <div class="sd-scale reveal">
        <div class="sd-scale__bar" aria-hidden="true">
          <span>3"</span><span>36"</span>
        </div>
        <ol class="sd-scale__steps">
          {c.feature.items.map((it, i) => (
            <li style={`--d:${i * 0.1}s; --s:${0.5 + i * 0.28}`}>
              <span class="sd-scale__ring" aria-hidden="true"><i></i></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="sd-scale__photo reveal">
        <img src="/images/tuberias-2.webp" alt={es ? "Tubería de acero apilada para tendido" : "Steel pipe stacked for installation"} width="1800" height="1350" loading="lazy" />
      </div>
    </div>
  </section>
)}

{serviceKey === "environmental" && (
  <section class="sd-sig">
    <div class="container-nex sd-cycle-wrap">
      <div>
        <h2 class="title-split reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
        <p class="lead mt-6 reveal">{es ? "Cada frente se gestiona con trazabilidad y registros que respaldan el cumplimiento ambiental." : "Each front is managed with traceability and records that support environmental compliance."}</p>
      </div>
      <div class="sd-cycle reveal" role="list">
        {c.feature.items.map((it, i) => (
          <div class="sd-cycle__item" role="listitem" style={`--i:${i}`}>
            <span class="icon-tile icon-tile--green"><Icon name={ficons[i]} size={22} /></span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </div>
        ))}
        <div class="sd-cycle__core" aria-hidden="true">
          <Icon name="refresh-cw" size={30} />
        </div>
      </div>
    </div>
  </section>
)}

{serviceKey === "chemicals" && (
  <section class="sd-sig">
    <div class="container-nex">
      <h2 class="title-split reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
      <div class="sd-bento">
        {c.feature.items.map((it, i) => (
          <article class={`sd-bento__cell reveal ${i === 0 ? "sd-bento__cell--lead" : ""}`} style={`--d:${i * 0.07}s`}>
            {i === 0 && <img src={meta.image} alt={it.title} width="1200" height="900" loading="lazy" />}
            <div class="sd-bento__body">
              <span class="icon-tile"><Icon name={ficons[i]} size={22} /></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{serviceKey === "logistics" && (
  <section class="sd-sig band-dark relative overflow-x-clip py-24 md:py-28">
    <div class="container-nex">
      <h2 class="title-split text-center reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
      <div class="sd-cargo">
        {c.feature.items.map((it, i) => (
          <div class="frame reveal" style={`--d:${i * 0.07}s`}>
            <article class="card h-full">
              <Icon name={ficons[i]} size={28} class="sd-equip__icon" />
              <h3 class="mt-5 text-[19px] sd-h-light">{it.title}</h3>
              <p class="mt-2 text-[15px] text-nex-gris leading-relaxed">{it.text}</p>
            </article>
          </div>
        ))}
      </div>
      <div class="sd-route reveal">
        <div class="sd-route__line" aria-hidden="true"><span class="sd-route__truck"><Icon name="truck" size={20} /></span></div>
        <ol>
          {c.process.map((p, i) => (
            <li>
              <span class="sd-route__dot" aria-hidden="true"></span>
              <span class="sd-route__n">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

{serviceKey === "staffing" && (
  <section class="sd-sig">
    <div class="container-nex sd-people">
      <div class="sd-people__grid">
        {c.feature.items.map((it, i) => (
          <article class="sd-people__card reveal" style={`--d:${i * 0.07}s`}>
            <span class="sd-people__avatar"><Icon name={ficons[i]} size={24} /></span>
            <div>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
          </article>
        ))}
      </div>
      <div>
        <h2 class="title-split reveal">{c.feature.title}<span>{c.feature.sub}</span></h2>
        <div class="sd-people__media reveal">
          <img src="/images/carreras.webp" alt={es ? "Personal técnico revisando planos" : "Technical staff reviewing drawings"} width="1800" height="1200" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
)}

<!-- ================= SCOPE + SIDEBAR ================= -->
<section id="alcance" class="sd-scope">
  <div class="container-nex sd-scope__grid">
    <div>
      <h2 class="title-split reveal">{c.capsTitle}</h2>
      <ul class="sd-caps">
        {c.capabilities.map((cap, i) => (
          <li class="reveal" style={`--d:${i * 0.04}s`}>
            <span class="sd-caps__check"><Icon name="check" size={16} /></span>
            {cap}
          </li>
        ))}
      </ul>
    </div>
    <aside class="sd-aside reveal">
      <div class="frame">
        <div class="card">
          <h3 class="text-[17px]">{c.standardsTitle}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {c.standards.map((s) => <span class="chip">{s}</span>)}
          </div>
          <h3 class="mt-8 text-[17px]">{L.contracts}</h3>
          <ul class="mt-3 grid gap-2">
            {c.contractModels.map((m) => (
              <li class="flex items-center gap-2.5 text-[15px] text-nex-gris">
                <Icon name="file-text" size={16} class="text-nex-azul" />
                {m}
              </li>
            ))}
          </ul>
          <a href={nav.contact} class="btn btn-primary w-full mt-8">
            {L.talk}
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- ================= PROCESS (logistics already shows it as a route) ================= -->
{serviceKey !== "logistics" && (
  <section class="sd-process">
    <div class="container-nex">
      <div class="text-center flex flex-col items-center">
        <p class="eyebrow reveal">{L.process}</p>
        <h2 class="title-split mt-6 reveal">{L.processSub}</h2>
      </div>
      <ol class="sd-steps">
        {c.process.map((p, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="sd-steps__n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- ================= RELATED ================= -->
<section class="sd-related">
  <div class="container-nex">
    <div class="flex items-end justify-between gap-6 flex-wrap">
      <h2 class="title-split reveal">{L.related}</h2>
      <a href={nav.services} class="btn btn-secondary btn-sm reveal">{t.nav.servicesMenu}<Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="sd-carousel" data-carousel>
      <button type="button" class="sd-carousel__btn sd-carousel__btn--prev" data-carousel-prev aria-label={es ? "Servicio anterior" : "Previous service"} disabled>
        <Icon name="arrow-right" size={20} />
      </button>
      <div class="sd-related__track" data-carousel-track>
        {others.map((s) => (
          <a href={servicePath(lang, s.key)} class="sd-related__card group">
            <img src={s.image} alt={s.title[lang]} width="600" height="400" loading="lazy" />
            <div class="sd-related__body">
              <span class="chip">{s.num}</span>
              <h3>{s.title[lang]}</h3>
              <span class="sd-related__more">{L.more}<Icon name="arrow-right" size={15} /></span>
            </div>
          </a>
        ))}
      </div>
      <button type="button" class="sd-carousel__btn sd-carousel__btn--next" data-carousel-next aria-label={es ? "Servicio siguiente" : "Next service"}>
        <Icon name="arrow-right" size={20} />
      </button>
      <div class="sd-carousel__progress" aria-hidden="true"><span data-carousel-bar></span></div>
    </div>
  </div>
</section>

<script>
  // Related services carousel: side arrows move one card at a time; progress bar follows the scroll
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const bar = root.querySelector<HTMLElement>("[data-carousel-bar]");
    if (!track || !prev || !next) return;
    const step = () => {
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.getBoundingClientRect().width + gap : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
      if (bar) {
        const visible = track.clientWidth / track.scrollWidth;
        bar.style.width = `${Math.max(visible * 100, 12)}%`;
        bar.style.transform = `translateX(${max > 0 ? (track.scrollLeft / max) * ((1 / Math.max(visible, 0.12)) - 1) * 100 : 0}%)`;
      }
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>

<CtaBand
  title={meta.title[lang]}
  text={L.cta}
  ctaLabel={t.common.requestProposal}
  ctaHref={nav.contact}
  secondaryLabel={t.common.backToServices}
  secondaryHref={nav.services}
/>

<style>
  /* ---------- shared hero pieces ---------- */
  .sd-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: #dbe3e8;
  }
  .sd-crumbs a:hover {
    color: var(--nex-ink);
  }
  .sd-crumbs--light,
  .sd-crumbs--light a {
    color: rgba(255, 255, 255, 0.78);
  }
  .sd-crumbs--light a:hover {
    color: #fff;
  }
  .sd-title {
    margin-top: 20px;
    font-size: clamp(36px, 4.8vw, 60px);
    line-height: 1.03;
    letter-spacing: -0.045em;
  }
  .sd-title--xl {
    font-size: clamp(40px, 6vw, 78px);
  }
  .sd-sub {
    margin-top: 22px;
    max-width: 560px;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.55;
    color: #e6edf1;
  }
  .sd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* split */
  .sd-hero--split {
    position: relative;
    isolation: isolate;
    padding: 140px 0 80px;
    overflow: hidden;
  }
  .sd-hero--split::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -160px;
    right: -10%;
    width: 760px;
    height: 620px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(47, 120, 180, 0.22), rgba(104, 176, 90, 0.08) 60%, transparent);
    filter: blur(40px);
  }
  .sd-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }
  .sd-split__media {
    position: relative;
  }
  .sd-split__media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 19px;
  }
  .sd-float {
    position: absolute;
    left: -28px;
    bottom: 32px;
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 300px;
    padding: 14px 18px 14px 14px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.136);
    box-shadow: 0 18px 40px -16px rgba(16, 42, 67, 0.35);
    backdrop-filter: blur(12px);
  }
  .sd-float strong {
    display: block;
    font-size: 13px;
    color: var(--nex-azul-text);
  }
  .sd-float span span {
    display: block;
    font-size: 14px;
    line-height: 1.35;
    color: var(--nex-ink);
  }

  /* immersive */
  .sd-hero--immersive {
    position: relative;
    isolation: isolate;
    min-height: max(620px, 92svh);
    display: flex;
    align-items: flex-end;
    padding: 140px 0 64px;
    overflow: hidden;
  }
  .sd-immersive__bg {
    -webkit-mask: linear-gradient(180deg, #000 70%, transparent 100%);
    mask: linear-gradient(180deg, #000 70%, transparent 100%);
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: sd-zoom 14s ease-out both;
  }
  .sd-immersive__shade {
    -webkit-mask: linear-gradient(180deg, #000 70%, transparent 100%);
    mask: linear-gradient(180deg, #000 70%, transparent 100%);
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(10, 25, 38, 0.15) 0%, rgba(10, 25, 38, 0.55) 55%, rgba(10, 25, 38, 0.88) 100%),
      linear-gradient(100deg, rgba(23, 64, 95, 0.75) 0%, rgba(23, 64, 95, 0.2) 55%, rgba(44, 110, 76, 0.35) 100%);
  }
  @keyframes sd-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1.04);
    }
  }
  .sd-immersive {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: end;
  }
  .sd-kicker-light {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a9d6ee;
  }
  .sd-title--light {
    color: #fff;
  }
  .sd-sub--light {
    color: rgba(255, 255, 255, 0.85);
  }
  .sd-glass {
    list-style: none;
    display: grid;
    gap: 14px;
    padding: 22px;
    border-radius: 22px;
