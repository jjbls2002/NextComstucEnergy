---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import CtaBand from "./CtaBand.astro";
import PageHero from "./PageHero.astro";
import { SERVICE_CONTENT } from "../data/services";
import { navItems, servicePath, SERVICES } from "../data/site";
import { useTranslations } from "../utils/i18n";
import type { Lang } from "../utils/i18n";
import type { ServiceKey } from "../data/site";

interface Props {
  serviceKey: ServiceKey;
  lang: Lang;
}
const { serviceKey, lang } = Astro.props;
const t = useTranslations(lang);
const nav = navItems(lang);
const c = SERVICE_CONTENT[serviceKey][lang];

const servicesLabel = lang === "es" ? "Servicios" : "Services";
const otherServices = SERVICES.filter((s) => s.key !== serviceKey);
const contractIntro =
  lang === "es"
    ? "Adaptamos el esquema contractual a la naturaleza de cada alcance."
    : "We adapt the contractual scheme to the nature of each scope.";
const relatedTitle = lang === "es" ? "Otras líneas de servicio" : "Other service lines";
const ctaText =
  lang === "es"
    ? "Solicite una propuesta técnica para este servicio."
    : "Request a technical proposal for this service.";
---

<PageHero
  eyebrow={servicesLabel}
  title={c.hero}
  subtitle={c.heroSub}
  crumbs={[{ name: servicesLabel, href: nav.services }, { name: SERVICES.find((s) => s.key === serviceKey)!.title[lang] }]}
/>

<Section>
  <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
    <!-- Capabilities -->
    <div>
      <span class="section-rule mb-6"></span>
      <h2 class="text-2xl md:text-3xl mb-6">{c.capsTitle}</h2>
      <ul class="space-y-3">
        {c.capabilities.map((cap) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-nex-success shrink-0"><Icon name="check-circle" size={22} /></span>
            <span class="text-nex-gris">{cap}</span>
          </li>
        ))}
      </ul>

      <h3 class="text-xl mt-10 mb-4">{t.common.contractModels}</h3>
      <p class="text-nex-gris mb-4">{contractIntro}</p>
      <div class="flex flex-wrap gap-3">
        {c.contractModels.map((m) => (
          <span class="chip !py-2 !px-4 text-nex-blanco">
            <Icon name="file-text" size={16} class="text-nex-oro" />
            {m}
          </span>
        ))}
      </div>
    </div>

    <!-- Standards sidebar -->
    <aside>
      <div class="card-navy sticky top-24">
        <div class="flex items-center gap-3 mb-5">
          <span class="icon-tile"><Icon name={c.icon} size={24} /></span>
          <h2 class="text-nex-blanco text-lg m-0">{t.common.standards}</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          {c.standards.map((s) => (
            <span class="inline-flex items-center rounded-full border border-nex-oro/60 bg-nex-gold/10 px-3 py-1 text-xs font-semibold text-nex-oro-light">{s}</span>
          ))}
        </div>
        <a href={nav.contact} class="btn btn-on-navy w-full mt-8">
          {t.common.requestProposal}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </aside>
  </div>
</Section>

<!-- Related services -->
<Section variant="off-white" eyebrow={servicesLabel} title={relatedTitle}>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {otherServices.map((s) => (
      <a href={servicePath(lang, s.key)} class="card h-full group">
        <div class="flex items-center justify-between mb-4">
          <span class="num-badge">{s.num}</span>
          <Icon name="arrow-up-right" size={20} class="text-nex-oro transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </div>
        <h3 class="text-base">{s.title[lang]}</h3>
      </a>
    ))}
  </div>
</Section>

<CtaBand
  title={SERVICES.find((s) => s.key === serviceKey)!.title[lang]}
  text={ctaText}
  ctaLabel={t.common.requestProposal}
  ctaHref={nav.contact}
  secondaryLabel={t.common.backToServices}
  secondaryHref={nav.services}
/>
