---
import { getAlternatePath, getLangFromUrl } from "../utils/i18n";

interface Props {
  /** kept for backwards compatibility; both variants render the same glass toggle */
  variant?: "light" | "dark";
}
const lang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

const esHref = getAlternatePath(pathname, "es");
const enHref = getAlternatePath(pathname, "en");
---

<div class="lang-switch" role="group" aria-label="Language selector">
  <a href={esHref} hreflang="es" lang="es" data-set-lang="es" aria-current={lang === "es" ? "true" : undefined}>ES</a>
  <a href={enHref} hreflang="en" lang="en" data-set-lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
</div>

<style>
  .lang-switch {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.064);
    border: 1px solid rgba(255, 255, 255, 0.196);
  }
  .lang-switch a {
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--nex-gris);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .lang-switch a:hover {
    color: var(--nex-ink);
  }
  .lang-switch a[aria-current="true"] {
    color: #fff;
    background: var(--nex-azul);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  // Persist chosen language in a 1-year cookie when the user switches.
  document.querySelectorAll<HTMLAnchorElement>("[data-set-lang]").forEach((el) => {
    el.addEventListener("click", () => {
      const lang = el.getAttribute("data-set-lang");
      if (lang) {
        document.cookie = `nex_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
      }
    });
  });
</script>
