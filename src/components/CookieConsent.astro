---
import { getLangFromUrl, useTranslations } from "../utils/i18n";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.cookies;
const ga4 = import.meta.env.PUBLIC_GA4_ID as string | undefined;
---

<!-- Cookie banner: compact card, bottom-left on desktop, full width on phones -->
<div id="cookie-banner" class="cookie-card hidden" role="dialog" aria-live="polite" aria-labelledby="cookie-card-title">
  <p id="cookie-card-title" class="cookie-card__title">{lang === "es" ? "Usamos cookies" : "We use cookies"}</p>
  <p class="cookie-card__text">
    {c.banner}
    <a href={lang === "es" ? "/es/cookies/" : "/en/cookies/"}>{lang === "es" ? "Más información" : "Learn more"}</a>
  </p>
  <div class="cookie-card__actions">
    <button type="button" data-cookie="accept" class="btn btn-primary btn-sm">{c.acceptAll}</button>
    <button type="button" data-cookie="reject" class="btn btn-secondary btn-sm">{c.rejectOptional}</button>
  </div>
  <button type="button" data-cookie="prefs" class="cookie-card__prefs">{c.preferences}</button>
</div>

<style>
  .cookie-card {
    position: fixed;
    z-index: 70;
    left: 20px;
    bottom: 20px;
    width: min(380px, calc(100vw - 32px));
    padding: 20px 20px 16px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.136);
    box-shadow: 0 24px 60px -20px rgba(16, 42, 67, 0.35);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    animation: cookie-in 0.6s var(--nex-ease) both;
  }
  .cookie-card.hidden {
    display: none;
  }
  .cookie-card__title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--nex-ink);
  }
  .cookie-card__text {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.55;
    color: #e6edf1;
  }
  .cookie-card__text a {
    margin-left: 4px;
    color: var(--nex-azul-text);
    font-weight: 500;
    border-bottom: 1px solid rgba(47, 120, 180, 0.35);
  }
  .cookie-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 16px;
  }
  .cookie-card__actions .btn {
    width: 100%;
    height: 40px;
    padding: 0 12px;
    font-size: 13.5px;
  }
  .cookie-card__prefs {
    display: block;
    width: 100%;
    margin-top: 10px;
    padding: 4px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: #dbe3e8;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .cookie-card__prefs:hover {
    color: var(--nex-ink);
  }
  @keyframes cookie-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 480px) {
    .cookie-card {
      left: 16px;
      right: 16px;
      bottom: 16px;
      width: auto;
    }
  }
</style>

<!-- Preferences modal -->
<div id="cookie-modal" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true" aria-labelledby="cookie-modal-title">
  <div class="absolute inset-0 bg-[rgba(14,26,36,0.35)] backdrop-blur-sm" data-cookie="close-backdrop"></div>
  <div class="relative min-h-full flex items-center justify-center p-4">
    <div class="bg-[rgba(24,28,24,0.96)] border border-white/15 rounded-[22px] shadow-[0_20px_50px_rgba(16,42,67,0.18)] w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="p-6 md:p-8">
        <h2 id="cookie-modal-title" class="text-2xl mb-6 text-nex-blanco">{c.title}</h2>

        <div class="space-y-5">
          <div class="flex items-start justify-between gap-4 border-b border-white/8 pb-5">
            <div>
              <h3 class="text-base font-semibold text-nex-blanco">{c.necessary}</h3>
              <p class="text-sm text-nex-gris mt-1">{c.necessaryDesc}</p>
            </div>
            <span class="chip shrink-0 mt-1">{c.alwaysOn}</span>
          </div>

          <div class="flex items-start justify-between gap-4 border-b border-white/8 pb-5">
            <div>
              <h3 class="text-base font-semibold text-nex-blanco">{c.analytics}</h3>
              <p class="text-sm text-nex-gris mt-1">{c.analyticsDesc}</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" data-cat="analytics" class="sr-only peer" />
              <span class="w-11 h-6 bg-white/15 rounded-full peer peer-checked:bg-nex-azul transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-[#fff] after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></span>
              <span class="sr-only">{c.analytics}</span>
            </label>
          </div>

          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-base font-semibold text-nex-blanco">{c.marketing}</h3>
              <p class="text-sm text-nex-gris mt-1">{c.marketingDesc}</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" data-cat="marketing" class="sr-only peer" />
              <span class="w-11 h-6 bg-white/15 rounded-full peer peer-checked:bg-nex-azul transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-[#fff] after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-5"></span>
              <span class="sr-only">{c.marketing}</span>
            </label>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <button type="button" data-cookie="save" class="btn btn-primary text-sm">{c.save}</button>
          <button type="button" data-cookie="accept" class="btn btn-secondary text-sm">{c.acceptAll}</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ga4 }}>
  (function () {
    var KEY = "nex_cookie_consent";
    var VERSION = "1.0";
    var banner = document.getElementById("cookie-banner");
    var modal = document.getElementById("cookie-modal");

    function read() {
      try { return JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) { return null; }
    }
    function save(consent) {
      var payload = { necessary: true, analytics: !!consent.analytics, marketing: !!consent.marketing, timestamp: new Date().toISOString(), version: VERSION };
      try { localStorage.setItem(KEY, JSON.stringify(payload)); } catch (e) {}
      apply(payload); hideBanner(); hideModal();
    }
    function showBanner() { if (banner) banner.classList.remove("hidden"); }
    function hideBanner() { if (banner) banner.classList.add("hidden"); }
    function showModal() {
      if (!modal) return;
      var c = read() || { analytics: false, marketing: false };
      modal.querySelectorAll("[data-cat]").forEach(function (el) { el.checked = !!c[el.getAttribute("data-cat")]; });
      modal.classList.remove("hidden"); document.body.style.overflow = "hidden";
    }
    function hideModal() { if (modal) modal.classList.add("hidden"); document.body.style.overflow = ""; }

    function loadGA() {
      if (!ga4 || window.__nexGaLoaded) return;
      window.__nexGaLoaded = true;
      var s = document.createElement("script");
      s.async = true; s.src = "https://www.googletagmanager.com/gtag/js?id=" + ga4;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("config", ga4, { anonymize_ip: true });
    }
    function apply(c) { if (c && c.analytics) loadGA(); }

    document.querySelectorAll('[data-cookie]').forEach(function (btn) {
      btn.addEventListener("click", function () {
        var action = btn.getAttribute("data-cookie");
        if (action === "accept") save({ analytics: true, marketing: true });
        else if (action === "reject") save({ analytics: false, marketing: false });
        else if (action === "prefs") showModal();
        else if (action === "close-backdrop") hideModal();
        else if (action === "save") {
          var c = { analytics: false, marketing: false };
          if (modal) modal.querySelectorAll("[data-cat]").forEach(function (el) { c[el.getAttribute("data-cat")] = el.checked; });
          save(c);
        }
      });
    });
    document.querySelectorAll("[data-open-cookie-prefs]").forEach(function (b) { b.addEventListener("click", showModal); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") hideModal(); });

    var existing = read();
    if (existing && existing.version === VERSION) apply(existing);
    else showBanner();
  })();
</script>
